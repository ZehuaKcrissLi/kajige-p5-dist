local function ShowAlert(title, action, severity, duration)
    if not DB.enabled then return end
    local colors = {
        [1] = "|cffffff00",
        [2] = "|cffff9a00",
        [3] = "|cffff3030",
    }
    alertTitle:SetText((colors[severity] or colors[2]) .. title .. "|r")
    alertAction:SetText(action)
    alert:SetBackdropBorderColor(
        severity == 3 and 1 or 1,
        severity == 3 and 0.12 or 0.58,
        0.05,
        1
    )
    alert:Show()
    displayUntil = GetTime() + (duration or (severity == 3 and 7 or 4))
    if DB.sound and severity >= 2 then
        PlaySoundFile("Sound\\Interface\\RaidWarning.wav")
    end
    if RaidNotice_AddMessage and RaidWarningFrame then
        RaidNotice_AddMessage(RaidWarningFrame, title .. "： " .. action, ChatTypeInfo.RAID_WARNING)
    end
end

local function ScheduleTimer(definition)
    if not definition then return end
    local key = definition[1]
    local minimum = tonumber(definition[3])
    if not key or not minimum then return end
    activeTimers[key] = {
        label = definition[2],
        at = GetTime() + minimum,
        latestAt = GetTime() + (tonumber(definition[4]) or minimum),
        minimum = minimum,
        maximum = tonumber(definition[4]),
        action = definition[5],
        severity = definition[6] or 2,
        warned = false,
    }
end

local function PrimeTimers(boss)
    activeTimers = {}
    for _, definition in ipairs(boss.openers or {}) do
        ScheduleTimer(definition)
    end
    if next(activeTimers) then timeline:Show() else timeline:Hide() end
end

local function SetPhase(phase, severity)
    if not activeBoss or not activeBoss.phases[phase] then return end
    activePhase = phase
    ShowAlert(
        activeBoss.name .. "：进入阶段 " .. phase,
        activeBoss.phases[phase],
        severity or 3,
        11
    )
end

