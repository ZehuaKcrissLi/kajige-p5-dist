local function CreatureID(guid)
    if type(guid) ~= "string" or string.sub(guid, 1, 4) ~= "0xF1" then return nil end
    return tonumber(string.sub(guid, 7, 12), 16)
end

local function ActivateBoss(creatureID)
    local boss = bosses[creatureID]
    if not boss then return end
    if activeBoss == boss then
        if boss == bosses[25315] and creatureID == 25315 and activePhase == 1 then
            activeCreatureID = creatureID
            activeStartedAt = GetTime()
            delayedPhase = nil
            PrimeTimers(boss)
            SetPhase(2, 3)
        elseif boss == bosses[25741] and creatureID == 25840 and activePhase < 3 then
            activeCreatureID = creatureID
            delayedPhase = nil
            SetPhase(3, 3)
        end
        return
    end
    pendingCreatureID = nil
    activeBoss = boss
    activeCreatureID = creatureID
    activePhase = 1
    activeStartedAt = GetTime()
    delayedPhase = nil
    PrimeTimers(boss)
    if KajigeSunwellTankCoach_ActivateBoss then
        KajigeSunwellTankCoach_ActivateBoss(creatureID)
    end
    ShowAlert(
        boss.name .. "：阶段 1",
        boss.phases[1],
        2,
        10
    )
end

local function UnitIsEncounterActive(unit)
    return UnitAffectingCombat and UnitAffectingCombat(unit)
end

local function CheckUnit(unit)
    if not UnitExists(unit) then return end
    local creatureID = CreatureID(UnitGUID(unit))
    if creatureID and bosses[creatureID] and activeBoss ~= bosses[creatureID] then
        if UnitIsEncounterActive(unit) then
            ActivateBoss(creatureID)
        else
            pendingCreatureID = creatureID
        end
    end
    if not activeBoss or not activeBoss.health or not UnitCanAttack("player", unit) then return end
    local maximum = UnitHealthMax(unit)
    if not maximum or maximum <= 0 then return end
    local percent = UnitHealth(unit) * 100 / maximum
    for _, transition in ipairs(activeBoss.health) do
        if transition.phase > activePhase and percent <= transition.threshold then
            SetPhase(transition.phase, 3)
        end
    end
end

local function IsEncounterCombatEvent(subEvent)
    if not subEvent then return false end
    return subEvent == "SWING_DAMAGE"
        or subEvent == "SWING_MISSED"
        or string.find(subEvent, "_DAMAGE", 1, true)
        or string.find(subEvent, "_MISSED", 1, true)
        or string.find(subEvent, "_CAST_", 1, true)
        or string.find(subEvent, "_AURA_APPLIED", 1, true)
        or string.find(subEvent, "_SUMMON", 1, true)
end

local function HandleCombatLog(...)
    local _, subEvent, sourceGUID, _, _, destGUID, destName, _, spellID = ...
    local sourceID = CreatureID(sourceGUID)
    local destID = CreatureID(destGUID)
    if IsEncounterCombatEvent(subEvent) then
        if sourceID and bosses[sourceID] then
            ActivateBoss(sourceID)
        elseif destID and bosses[destID] then
            ActivateBoss(destID)
        end
    end
    if not activeBoss then return end
    if subEvent == "UNIT_DIED"
        and (destID == 25165 or destID == 25166)
        and activeBoss == bosses[25165] then
        SetPhase(3, 3)
        return
    end
    if not spellID then return end
    local nextPhase = activeBoss.phaseBySpell
        and activeBoss.phaseBySpell[spellID]
    if nextPhase and nextPhase > activePhase then SetPhase(nextPhase, 3) end
    if activeBoss == bosses[25315] and spellID == 45892 and activePhase >= 2 and activePhase < 5 then
        SetPhase(activePhase + 1, 3)
    end
    if activeBoss == bosses[25038]
        and activePhase > 1
        and (spellID == 45855 or spellID == 45866) then
        delayedPhase = nil
        SetPhase(1, 3)
    end
    local delayed = activeBoss.delayedPhaseBySpell
        and activeBoss.delayedPhaseBySpell[spellID]
    if delayed then
        delayedPhase = {
            at = GetTime() + delayed.delay,
            phase = delayed.phase,
        }
    end
    local timerDefinition = activeBoss.timers
        and activeBoss.timers[spellID]
    if timerDefinition then
        ScheduleTimer(timerDefinition)
        timeline:Show()
    end
    local mechanic = activeBoss.alerts[spellID]
    if not mechanic then return end
    if mechanic[4] and destName and destName ~= UnitName("player") then
        if subEvent ~= "SPELL_AURA_APPLIED" then return end
    end
    local key = tostring(spellID) .. ":" .. tostring(destName) .. ":" .. tostring(subEvent)
    local now = GetTime()
    if lastAlert[key] and now - lastAlert[key] < 2.5 then return end
    lastAlert[key] = now
    local title = mechanic[1]
    if destName and destName ~= "" then title = title .. " → " .. destName end
    ShowAlert(title, mechanic[2], mechanic[3])
end

local function HandleBossSpeech(event, message)
    if not activeBoss or type(message) ~= "string" then return end
    local normalized = string.lower(message)
    for _, transition in ipairs(activeBoss.speechPhases or {}) do
        for _, pattern in ipairs(transition.patterns or {}) do
            if string.find(normalized, string.lower(pattern), 1, true) then
                SetPhase(transition.phase, 3)
                break
            end
        end
    end
    for _, speechAlert in ipairs(activeBoss.speechAlerts or {}) do
        for _, pattern in ipairs(speechAlert.patterns or {}) do
            if string.find(normalized, string.lower(pattern), 1, true) then
                ShowAlert(
                    speechAlert.title,
                    speechAlert.action,
                    speechAlert.severity or 3,
                    speechAlert.duration
                )
                break
            end
        end
    end
    if activeBoss == bosses[25038] then
        if event == "CHAT_MSG_MONSTER_YELL"
            and (string.find(message, "我比以前更强大了", 1, true)
                or string.find(message, "stronger than ever", 1, true)) then
            SetPhase(2, 3)
        elseif event == "CHAT_MSG_RAID_BOSS_WHISPER"
            and (string.find(message, "深深地吸了一口气", 1, true)
                or string.find(message, "deep breath", 1, true)) then
            SetPhase(3, 3)
        end
    end
end

local function ResetEncounterState()
    activeBoss = nil
    activeCreatureID = nil
    pendingCreatureID = nil
    activePhase = 1
    activeStartedAt = 0
    activeTimers = {}
    delayedPhase = nil
    lastAlert = {}
    displayUntil = 0
    alert:Hide()
    timeline:Hide()
    if KajigeSunwellTankCoach_Reset then
        KajigeSunwellTankCoach_Reset()
    end
end

function KajigeRaidCoach_Reset()
    ResetEncounterState()
end

local eventFrame = CreateFrame("Frame")
eventFrame:RegisterEvent("PLAYER_TARGET_CHANGED")
eventFrame:RegisterEvent("PLAYER_FOCUS_CHANGED")
eventFrame:RegisterEvent("COMBAT_LOG_EVENT_UNFILTERED")
eventFrame:RegisterEvent("CHAT_MSG_MONSTER_YELL")
eventFrame:RegisterEvent("CHAT_MSG_RAID_BOSS_WHISPER")
eventFrame:RegisterEvent("PLAYER_REGEN_DISABLED")
eventFrame:RegisterEvent("PLAYER_REGEN_ENABLED")
eventFrame:SetScript("OnEvent", function(_, event, ...)
    if event == "PLAYER_TARGET_CHANGED" then
        CheckUnit("target")
    elseif event == "PLAYER_FOCUS_CHANGED" then
        CheckUnit("focus")
    elseif event == "COMBAT_LOG_EVENT_UNFILTERED" then
        HandleCombatLog(...)
    elseif event == "CHAT_MSG_MONSTER_YELL"
        or event == "CHAT_MSG_RAID_BOSS_WHISPER" then
        HandleBossSpeech(event, ...)
    elseif event == "PLAYER_REGEN_DISABLED" then
        CheckUnit("target")
        CheckUnit("focus")
    elseif event == "PLAYER_REGEN_ENABLED" then
        ResetEncounterState()
    end
end)

eventFrame:SetScript("OnUpdate", function(_, elapsed)
    local now = GetTime()
    if alert:IsShown() and now >= displayUntil then alert:Hide() end
    if activeBoss then
        for _, transition in ipairs(activeBoss.timedPhases or {}) do
            if activePhase < transition.phase
                and now - activeStartedAt >= transition.at then
                SetPhase(transition.phase, 3)
            end
        end
    end
    if delayedPhase and now >= delayedPhase.at then
        local phase = delayedPhase.phase
        delayedPhase = nil
        SetPhase(phase, 3)
    end
    local nextTimer
    local expired = {}
    for key, timer in pairs(activeTimers) do
        if now > timer.latestAt + 2 then
            table.insert(expired, key)
        elseif not nextTimer or timer.at < nextTimer.at then
            nextTimer = timer
        end
    end
    for _, key in ipairs(expired) do activeTimers[key] = nil end
    if nextTimer and activeBoss then
        local remaining = nextTimer.at - now
        local countdown
        if remaining > 0 then
            countdown = string.format("%.1f 秒", remaining)
            if nextTimer.maximum then
                countdown = countdown .. "～"
                    .. string.format(
                        "%.1f 秒",
                        math.max(0, nextTimer.latestAt - now)
                    )
            end
        else
            countdown = "即将发生"
        end
        timelineText:SetText(
            "|cffffd100" .. activeBoss.name .. "|r　"
            .. nextTimer.label .. "：|cffffffff" .. countdown .. "|r"
        )
        timeline:Show()
        if remaining <= 5 and not nextTimer.warned then
            nextTimer.warned = true
            ShowAlert(
                nextTimer.label .. "：5 秒内",
                nextTimer.action,
                nextTimer.severity,
                5
            )
        end
    elseif activeBoss then
        timelineText:SetText(
            "|cffffd100" .. activeBoss.name
            .. "|r　等待下一项可识别机制"
        )
        timeline:Show()
    else
        timeline:Hide()
    end
    pollElapsed = pollElapsed + elapsed
    if pollElapsed < 0.35 then return end
    pollElapsed = 0
    CheckUnit("target")
    CheckUnit("focus")
end)

-- Deterministic read-only hooks for the release gate. They exercise the same
-- event handlers, phase state, timers, alert frame and sound path as combat;
-- no gameplay command, unit state or SavedVariables value is changed.
KajigeRaidCoachTestHooks = {
    definitions = bosses,
    order = bossOrder,
    activate = ActivateBoss,
    checkUnit = CheckUnit,
    combat = HandleCombatLog,
    speech = HandleBossSpeech,
    clearTimers = function()
        activeTimers = {}
        timeline:Hide()
    end,
    update = function(elapsed)
        eventFrame:GetScript("OnUpdate")(eventFrame, elapsed)
    end,
    reset = function()
        ResetEncounterState()
    end,
    snapshot = function()
        local timerCount = 0
        for _ in pairs(activeTimers) do timerCount = timerCount + 1 end
        return {
            creatureID = activeCreatureID,
            phase = activePhase,
            timerCount = timerCount,
            alertShown = alert:IsShown(),
            alertTitle = alertTitle:GetText(),
            alertAction = alertAction:GetText(),
            timelineShown = timeline:IsShown(),
            timelineText = timelineText:GetText(),
        }
    end,
}

SLASH_KAJIGERAIDCOACH1 = "/swcoach"
SlashCmdList.KAJIGERAIDCOACH = function(message)
    message = string.lower(message or "")
    if message == "on" then
        DB.enabled = true
        DEFAULT_CHAT_FRAME:AddMessage("|cff00ff96机制强提示已开启。|r")
    elseif message == "off" then
        DB.enabled = false
        alert:Hide()
        DEFAULT_CHAT_FRAME:AddMessage("|cffffff00机制强提示已关闭。|r")
    elseif message == "sound" then
        DB.sound = not DB.sound
        DEFAULT_CHAT_FRAME:AddMessage("|cff00ff96提示音：" .. (DB.sound and "开启" or "关闭") .. "。|r")
    else
        if guide:IsShown() then guide:Hide() else guide:Show() end
    end
end
