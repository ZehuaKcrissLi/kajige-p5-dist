local function CurrentGroupSize()
    local raidCount = GetNumRaidMembers() or 0
    if raidCount > 0 then return raidCount end
    return (GetNumPartyMembers() or 0) + 1
end

local function CurrentOnlineGroupSize()
    local raidCount = GetNumRaidMembers() or 0
    if raidCount > 0 then
        local online = 0
        for index = 1, raidCount do
            local connected = select(8, GetRaidRosterInfo(index))
            if connected then online = online + 1 end
        end
        return online
    end
    local online = UnitIsConnected("player") and 1 or 0
    for index = 1, (GetNumPartyMembers() or 0) do
        if UnitIsConnected("party" .. index) then
            online = online + 1
        end
    end
    return online
end

local function RestoreOfflineBots()
    local current = CurrentGroupSize()
    local online = CurrentOnlineGroupSize()
    if current <= online then
        Print("当前编制中的成员都已在线，无需恢复。")
        return false
    end
    if fillState or singleAddState then
        Print("已有机器人编组任务正在运行，请等待完成后再恢复。", true)
        return false
    end
    QueueCommand(".kjg bot restoreoffline")
    Print(
        "正在并发恢复离线训练机器人；当前在线 "
        .. online .. "/" .. current
        .. "，原角色、装备、职责与团队槽位都会保留。"
    )
    return true
end

local function CurrentGroupMemberNames()
    local names = {}
    local raidCount = GetNumRaidMembers() or 0
    if raidCount > 0 then
        for index = 1, raidCount do
            local name = UnitName("raid" .. index)
            if name then names[name] = true end
        end
        return names
    end
    local playerName = UnitName("player")
    if playerName then names[playerName] = true end
    for index = 1, (GetNumPartyMembers() or 0) do
        local name = UnitName("party" .. index)
        if name then names[name] = true end
    end
    return names
end

local function FindNewGroupMemberName(beforeNames)
    for name in pairs(CurrentGroupMemberNames()) do
        if not beforeNames[name] then return name end
    end
end

local function ContinueFillRoster()
    if not fillState then return end
    local current = CurrentGroupSize()
    local online = CurrentOnlineGroupSize()
    if fillState.stage == "restoreOffline" then
        if current > online then
            fillState.restoreWaits = fillState.restoreWaits + 1
            if fillState.restoreWaits % 12 == 0 then
                Send(".kjg bot restoreoffline")
            end
            if fillState.restoreWaits <= 24 then
                QueueCommand(ContinueFillRoster)
                return
            end
            -- A genuine relog keeps the same slots and normally finishes in
            -- seconds. Only after a full 54-second Playerbots login window do
            -- we prune Bot-only stale slots and fall back to normal filling.
            fillState.stage = "pruneOffline"
            fillState.pruneWaits = 0
            Send(".kjg bot pruneoffline")
            QueueCommand(ContinueFillRoster)
            return
        end
        fillState.stage = "fill"
    end
    if fillState.stage == "pruneOffline" then
        if current > online then
            fillState.pruneWaits = fillState.pruneWaits + 1
            if fillState.pruneWaits % 10 == 0 then
                Send(".kjg bot pruneoffline")
            end
            QueueCommand(ContinueFillRoster)
            return
        end
        fillState.stage = "fill"
    end
    if current > fillState.targetSize or online > fillState.targetSize then
        fillState.stablePasses = 0
        Send(".kjg bot trim " .. fillState.targetSize)
        QueueCommand(ContinueFillRoster)
        return
    end
    if current >= fillState.targetSize
        and online >= fillState.targetSize then
        fillState.stablePasses = fillState.stablePasses + 1
        if fillState.stablePasses < 5 then
            QueueCommand(ContinueFillRoster)
            return
        end
        local onComplete = fillState.onComplete
        Print(
            "团队已经实际在线 " .. online
            .. "/" .. current .. " 人（真人与机器人合计）。"
        )
        fillState = nil
        if UpdateRosterStatus then UpdateRosterStatus() end
        if onComplete then QueueCommand(onComplete) end
        return
    end
    fillState.stablePasses = 0
    if current >= fillState.targetSize and online < current then
        fillState.stage = "pruneOffline"
        fillState.pruneWaits = 0
        Send(".kjg bot pruneoffline")
        QueueCommand(ContinueFillRoster)
        return
    end
    fillState.attempts = fillState.attempts + 1
    if fillState.attempts > 96 then
        Print(
            "补员未能达到 " .. fillState.targetSize
            .. " 人；当前 " .. current
            .. " 人，请检查机器人候选池。",
            true
        )
        fillState = nil
        return
    end

    -- addclass logs the bot in asynchronously. Do not submit another add
    -- while the previous request has not yet increased the real group size;
    -- otherwise the final two requests can race and create a 26-player raid.
    if fillState.pendingSize then
        if current > fillState.pendingSize then
            fillState.pendingSize = nil
            fillState.pendingWaits = 0
        else
            fillState.pendingWaits = fillState.pendingWaits + 1
            if fillState.pendingWaits <= 24 then
                QueueCommand(ContinueFillRoster)
                return
            end
            -- A candidate can occasionally fail to log in.  Give the
            -- asynchronous Playerbots login a full 54 seconds before trying
            -- another candidate; the former 18-second window could queue a
            -- replacement while the first bot was still loading.
            fillState.pendingSize = nil
            fillState.pendingWaits = 0
        end
    end

    if current > 1 and GetNumRaidMembers() == 0 then
        Send(".swp raid")
        QueueCommand(ContinueFillRoster)
        return
    end

    local className = roster[fillState.rosterIndex]
    fillState.rosterIndex = (fillState.rosterIndex % #roster) + 1
    Send(".playerbots bot addclass " .. className)
    fillState.pendingSize = current
    fillState.pendingWaits = 0
    QueueCommand(ContinueFillRoster)
end

local function FillRoster(targetSize, onComplete)
    targetSize = math.min(targetSize, 25)
    local current = CurrentGroupSize()
    if fillState then
        Print("补员任务已经在运行；当前团队 " .. current .. " 人。", true)
        return false
    end
    if singleAddState then
        Print("正在添加单个机器人，请完成后再执行一键补员。", true)
        return false
    end
    fillState = {
        targetSize = targetSize,
        rosterIndex = 1,
        attempts = 0,
        pendingSize = nil,
        pendingWaits = 0,
        restoreWaits = 0,
        pruneWaits = 0,
        stablePasses = 0,
        onComplete = onComplete,
        stage = "restoreOffline",
    }
    QueueCommand(".kjg bot restoreoffline")
    QueueCommand(ContinueFillRoster)
    Print(
        "正在优先让原有离线机器人并发上线，并按真人与机器人总人数把团队补到 "
        .. targetSize .. " 人。"
    )
    return true
end

local function FinishSingleBotAdd()
    if not singleAddState then return end
    local displayName = singleAddState.displayName
    local equipped = singleAddState.specKey and "，并已套用对应 P4 毕业装与 PvE 天赋" or ""
    singleAddState = nil
    if UpdateRosterStatus then UpdateRosterStatus() end
    Print("已添加 1 名" .. displayName .. "陪练" .. equipped .. "；真人玩家未被替换。")
end

local function ContinueSingleBotAdd()
    if not singleAddState then return end
    singleAddState.attempts = singleAddState.attempts + 1
    if singleAddState.attempts > 24 then
        local displayName = singleAddState.displayName
        singleAddState = nil
        Print("添加" .. displayName .. "陪练超时，请执行 /kjg audit 检查机器人池。", true)
        return
    end

    if singleAddState.stage == "pruneOffline" then
        local current = CurrentGroupSize()
        if current >= 25 then
            singleAddState = nil
            Print("当前在线团队已经有 25 人，请先移除一个成员。", true)
            return
        end
        singleAddState.startingSize = current
        -- pruneoffline can remove persisted offline members that addclass
        -- later reuses.  Snapshot names only after pruning; otherwise a
        -- reused bot name is mistaken for an old member and never receives
        -- its requested P4 template.
        singleAddState.beforeNames = CurrentGroupMemberNames()
        if current > 1 and GetNumRaidMembers() == 0 then
            Send(".swp raid")
            singleAddState.stage = "prepareRaid"
        else
            Send(".playerbots bot addclass " .. singleAddState.className)
            singleAddState.stage = "waitBot"
        end
        QueueCommand(ContinueSingleBotAdd)
        return
    end

    if singleAddState.stage == "prepareRaid" then
        if GetNumRaidMembers() > 0 then
            singleAddState.startingSize = CurrentGroupSize()
            Send(".playerbots bot addclass " .. singleAddState.className)
            singleAddState.stage = "waitBot"
        end
        QueueCommand(ContinueSingleBotAdd)
        return
    end

    if singleAddState.stage == "waitBot" then
        if CurrentGroupSize() > singleAddState.startingSize then
            if singleAddState.specKey and not singleAddState.gearApplied then
                local botName = FindNewGroupMemberName(singleAddState.beforeNames)
                if not botName then
                    QueueCommand(ContinueSingleBotAdd)
                    return
                end
                Send(
                    ".kjg gear player " .. botName
                    .. " " .. singleAddState.specKey
                )
                singleAddState.gearApplied = true
            end
            if GetNumRaidMembers() > 0 then
                FinishSingleBotAdd()
                return
            end
            Send(".swp raid")
            singleAddState.stage = "waitRaid"
        end
        QueueCommand(ContinueSingleBotAdd)
        return
    end

    if singleAddState.stage == "waitRaid" then
        if GetNumRaidMembers() > 0 then
            FinishSingleBotAdd()
            return
        end
        QueueCommand(ContinueSingleBotAdd)
    end
end

local function AddBotClass(className, displayName, specKey)
    if fillState or singleAddState then
        Print("已有机器人补员任务正在运行，请等待完成或停止命令队列。", true)
        return
    end

    singleAddState = {
        className = className,
        displayName = displayName,
        specKey = specKey,
        beforeNames = CurrentGroupMemberNames(),
        gearApplied = false,
        startingSize = nil,
        attempts = 0,
        stage = "pruneOffline",
    }
    QueueCommand(".kjg bot pruneoffline")
    QueueCommand(ContinueSingleBotAdd)
    Print(
        "正在恢复离线机器人槽位并添加 1 名" .. displayName
        .. "陪练；真人玩家不会被替换。"
    )
end

function KajigeSWT_AddP4Bot(specKey)
    if not IsLeaderOrGM() then
        Print("只有团长或 GM 可以添加 P4 毕业 BOT。", true)
        return false
    end
    if not KajigeTitanP4Data or not KajigeTitanP4Data.specs then
        Print("P4 配装数据尚未加载。", true)
        return false
    end
    for _, spec in ipairs(KajigeTitanP4Data.specs) do
        if spec.key == specKey then
