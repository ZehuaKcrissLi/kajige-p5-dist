    permissionMenuButton:SetHeight(30)
    permissionMenuButton:SetPoint("LEFT", GameMenuFrame, "RIGHT", 10, 36)
    permissionMenuButton:SetScript("OnClick", function()
        HideUIPanel(GameMenuFrame)
