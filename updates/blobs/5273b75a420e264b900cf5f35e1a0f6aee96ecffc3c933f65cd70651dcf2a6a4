local function HandleKJGSlash(message)
    local value = string.lower(
        string.gsub(string.gsub(message or "", "^%s+", ""), "%s+$", "")
    )
    if value == "" or value == "open" or value == "toggle" then
        TogglePanel()
        return
    end
    if value == "permission" or value == "permissions" or value == "access" then
        if permissionPanel then
            if permissionPanel:IsShown() then
                permissionPanel:Hide()
            else
                permissionPanel:Show()
                Send(".kjg permission")
            end
        end
        return
    end
    if value == "teleport" or value == "tp" then
        if not IsLeaderOrGM() then
            teleportScope = "self"
        end
        ToggleTeleportPanel()
        return
    end
    if value == "gear" or value == "p4" or value == "p5" or value == "bis" then
        if not IsLeaderOrGM() then
            gearTargetName = nil
        end
        if value == "p6" then gearPhase = "P6" end
        if value == "p5" then gearPhase = "P5" end
        if value == "p4" or value == "bis" then gearPhase = "P4" end
        ToggleGearPanel()
        return
    end
    if value == "god on" or value == "invincible on" then
        Send(".kjg self god on")
        return
    end
    if value == "god off" or value == "invincible off" then
        Send(".kjg self god off")
        return
    end
    local selfDps = string.match(value, "^dps%s+([%w]+)$")
    if selfDps then
        Send(".kjg self dps " .. selfDps)
        return
    end
    if value == "self" or value == "solo" or value == "status" then
        Send(".kjg self status")
        return
    end
    if value == "speed" or value == "speed on" or value == "run" or value == "run on" then
        Send(".kjg self speed on")
        return
    end
    if value == "speed off" or value == "run off" then
        Send(".kjg self speed off")
        return
    end
    if value == "mount" or string.match(value, "^mount%s+") then
        local mountAliases = {
            [""] = "phoenix", phoenix = "phoenix", ["凤凰"] = "phoenix",
            mimiron = "mimiron", ["米米尔隆"] = "mimiron",
            ["米米尔隆的头部"] = "mimiron",
            invincible = "invincible", ["无敌"] = "invincible",
            celestial = "celestial", ["星骓"] = "celestial",
        }
        local requested = string.match(value, "^mount%s*(.-)$") or ""
        local mountKey = mountAliases[requested]
        if mountKey then
            Send(".kjg self mount " .. mountKey)
        else
            Print("可选坐骑：/kjg mount 凤凰、米米尔隆的头部、无敌、星骓。", true)
        end
        return
    end
    if not IsLeaderOrGM() then
        Print(
            "普通账号可用：/kjg、/kjg teleport、/kjg god on/off、"
            .. "/kjg dps 10000-1000000、/kjg dps off、/kjg gear、"
            .. "/kjg speed on/off、/kjg mount 凤凰|米米尔隆的头部|无敌|星骓。",
            true
        )
        return
    end
    if value == "close" then
        if panel then panel:Hide() end
        if rosterPanel then rosterPanel:Hide() end
        if buffPanel then buffPanel:Hide() end
        if teleportPanel then teleportPanel:Hide() end
        if soloPanel then soloPanel:Hide() end
        if gearPanel then gearPanel:Hide() end
        if gearCatalogPanel then gearCatalogPanel:Hide() end
        return
    end
    if value == "fill" or value == "fill 25" then
        FillRoster(25)
        return
    end
    if value == "restore" or value == "restore bots" then
        RestoreOfflineBots()
        return
    end
    if value == "roster" then
        ToggleRosterPanel()
        return
    end
    if value == "buff" or value == "buffs" then
        ToggleBuffPanel()
        return
    end
    if value == "gear" or value == "p4" or value == "p5" then
        if value == "p6" then gearPhase = "P6" end
        if value == "p5" then gearPhase = "P5" end
        if value == "p4" then gearPhase = "P4" end
        ToggleGearPanel()
        return
    end
    if value == "buff standard" or value == "buffs standard" then
        Send(".kjg buff standard")
        return
    end
    if value == "buff clear" or value == "buffs clear" then
        Send(".kjg buff clear")
        return
    end
    if value == "buff status" or value == "buffs status" then
        Send(".kjg buff status")
        return
    end
    if value == "audit" then
        Send(".kjg audit")
        Print("训练状态审计命令已发送。")
        return
    end
    if value == "opener" or value == "start" then
        local started = FillRoster(25, function()
            QueueCommand(".kjg gear group P6")
            QueueCommand(".kjg bot formation spread")
            QueueCommand(".kjg bot dps 6000")
            QueueCommand(".kjg bot tps 12000")
            QueueCommand(".kjg bot threat tank 130")
            QueueCommand(".kjg bot tanks 2")
            QueueCommand(".kjg bot variance 12")
            QueueCommand(".swp ready")
            Print("25 人编制已就绪，正在应用标准训练开场。")
        end)
        if started then
            Print("标准训练开场已排队；补满 25 人后自动应用。")
        end
        return
    end
    local className = string.match(value, "^add%s+([a-z]+)$")
    if className and botClassLabels[className] then
        AddBotClass(className, botClassLabels[className])
        return
    end
    Print(
        "可用命令：/kjg、/kjg restore、/kjg fill、/kjg add 职业、/kjg roster、"
        .. "/kjg gear、/kjg buff、/kjg teleport、/kjg opener、"
        .. "/kjg audit、/kjg close。",
        true
    )
end

