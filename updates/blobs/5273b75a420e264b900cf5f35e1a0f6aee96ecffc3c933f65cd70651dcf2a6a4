local function GearData()
    return KajigeTitanGearData or KajigeTitanP4Data
end

local function GearSpec(specKey)
    local data = GearData()
    for _, spec in ipairs(data and data.specs or {}) do
        if spec.key == specKey then return spec end
    end
end

local function GearTemplate(specKey)
    local data = GearData()
    local phase = data and data.templates and data.templates[gearPhase]
    return phase and phase[specKey]
end

local function CopyGearChoice(choice)
    if not choice then return nil end
    local result = {
        id = choice.id,
        enchant = choice.enchant or 0,
        gems = {},
        source = choice.source,
        rank = choice.rank,
    }
    for index, gem in ipairs(choice.gems or {}) do
        result.gems[index] = gem
    end
    return result
end

local function ResetGearDraft()
    gearDraft = {}
    local template = GearTemplate(gearSelectedSpecKey)
    for slot, choice in pairs(template and template.gear or {}) do
        gearDraft[slot] = CopyGearChoice(choice)
    end
end

local function SameGearChoice(left, right)
    if not left or not right then return left == right end
    if left.id ~= right.id or (left.enchant or 0) ~= (right.enchant or 0) then
        return false
    end
    for index = 1, 3 do
        if (left.gems and left.gems[index] or 0)
            ~= (right.gems and right.gems[index] or 0) then
            return false
        end
    end
    return true
end

local function ShortText(value, limit)
    value = tostring(value or "")
    local byteIndex = 1
    local characters = 0
    while byteIndex <= string.len(value) and characters < limit do
        local first = string.byte(value, byteIndex)
        local width = first >= 240 and 4 or (first >= 224 and 3 or (first >= 192 and 2 or 1))
        byteIndex = byteIndex + width
        characters = characters + 1
    end
    if byteIndex > string.len(value) then return value end
    return string.sub(value, 1, byteIndex - 1) .. "..."
end

local function QualityColor(quality)
    local color = ITEM_QUALITY_COLORS and ITEM_QUALITY_COLORS[quality or 1]
    local hex = color and color.hex
    if not hex then return "|cffffffff" end
    if string.sub(hex, 1, 2) ~= "|c" then return "|c" .. hex end
    return hex
end

