local function QueueCommand(command)
    table.insert(queue, command)
end

frame:SetScript("OnUpdate", function(_, elapsed)
    if buffPanel and buffPanel:IsShown() and UpdateBuffStatuses then
        buffStatusElapsed = buffStatusElapsed + elapsed
        if buffStatusElapsed >= 0.75 then
            buffStatusElapsed = 0
            UpdateBuffStatuses()
        end
    end
    if #queue == 0 then return end
    queueElapsed = queueElapsed + elapsed
    if queueElapsed < queueInterval then return end
    queueElapsed = 0
    local action = table.remove(queue, 1)
    if type(action) == "function" then
        action()
    else
        SendChatMessage(action, "SAY")
    end
end)

local function Send(command)
    SendChatMessage(command, "SAY")
end

local addonCommandCounter = 0
local function SendCommandWhileDead(command)
    addonCommandCounter = (addonCommandCounter + 1) % 10000
    local sequence = string.format("%04d", addonCommandCounter)
    local commandBody = string.gsub(command or "", "^[.!]", "")
    local playerName = UnitName("player")
    if type(SendAddonMessage) == "function" and playerName and playerName ~= "" then
        -- AzerothCore's authenticated addon-command channel is accepted while
        -- dead, unlike SAY. The server still applies the normal RBAC checks.
        SendAddonMessage(
            "AzerothCore",
            "h" .. sequence .. commandBody,
            "WHISPER",
            playerName
        )
    else
        Send(command)
    end
end

local function PermissionHas(mask, flag)
    return math.floor((tonumber(mask) or 0) / flag) % 2 >= 1
end

local function PermissionFeatureSummary()
    local features = {}
    if PermissionHas(permissionState.mask, 1) then
        table.insert(features, "自传送")
    end
    if PermissionHas(permissionState.mask, 2) then
        table.insert(features, "个人无敌/DPS")
    end
    if PermissionHas(permissionState.mask, 4) then
        table.insert(features, "个人配装")
    end
    if PermissionHas(permissionState.mask, 8) then
        table.insert(features, "完整 KJG")
    end
    if PermissionHas(permissionState.mask, 16) then
        table.insert(features, "玩家管理")
    end
    if PermissionHas(permissionState.mask, 32) then
        table.insert(features, "世界管理")
    end
    if PermissionHas(permissionState.mask, 64) then
        table.insert(features, "系统管理")
    end
    if PermissionHas(permissionState.mask, 128) then
