local function RefreshGearCatalog()
    if not gearCatalogPanel or not gearCatalogSpecKey or not gearCatalogSlot then return end
    local data = GearData()
    local byPhase = data.candidates and data.candidates[gearPhase]
    local bySpec = byPhase and byPhase[gearCatalogSpecKey]
    local candidates = bySpec and bySpec[gearCatalogSlot] or {}
    local pageSize = 8
    local maxPage = math.max(1, math.ceil(#candidates / pageSize))
    gearCatalogPage = math.max(1, math.min(gearCatalogPage or 1, maxPage))
    local first = (gearCatalogPage - 1) * pageSize + 1
    local spec = GearSpec(gearCatalogSpecKey)
    gearCatalogTitle:SetText(
        gearPhase .. " · " .. (spec and spec.name or gearCatalogSpecKey)
        .. " · 替换" .. (gearSlotNames[gearCatalogSlot] or gearCatalogSlot)
    )
    gearCatalogPageLabel:SetText(
        "第 " .. gearCatalogPage .. "/" .. maxPage
        .. " 页，共 " .. #candidates .. " 件；点击只修改草稿，不会立刻穿上。"
    )
    for index, button in ipairs(gearCatalogButtons) do
        local choice = candidates[first + index - 1]
        local item = choice and data.items and data.items[choice.id]
        button.choice = choice
        if choice and item then
            button.icon:SetTexture(ResolveGearItemIcon(choice.id, item))
            local r, g, b = GearQualityRGB(item.quality)
            if button.iconFrame and button.iconFrame.SetBackdropBorderColor then
                button.iconFrame:SetBackdropBorderColor(r, g, b, 1)
            end
            button.name:SetText(
                QualityColor(item.quality) .. ShortText(item.name, 42) .. "|r"
                .. "  |cffffffff装等 " .. (item.itemLevel or 0) .. "|r"
            )
            button.detail:SetText(
                "来源：" .. ShortText(choice.source, 65)
                .. " · " .. GearEnhancementSummary(choice)
            )
            button:Show()
        else
            button.choice = nil
            button:Hide()
        end
    end
end

