local function ForEachGroupUnit(callback)
    local raidCount = GetNumRaidMembers() or 0
    if raidCount > 0 then
        for index = 1, raidCount do callback("raid" .. index) end
        return raidCount
    end
    callback("player")
    local partyCount = GetNumPartyMembers() or 0
    for index = 1, partyCount do callback("party" .. index) end
    return partyCount + 1
end

local function UnitHasManagedAura(unit, auraIDs)
    for _, spellID in ipairs(auraIDs) do
        local spellName = GetSpellInfo and GetSpellInfo(spellID)
        if spellName and UnitBuff and UnitBuff(unit, spellName) then
            return true
        end
    end
    return false
end

UpdateBuffStatuses = function()
    local total = CurrentGroupSize()
    for _, definition in ipairs(raidBuffs) do
        local covered = 0
        ForEachGroupUnit(function(unit)
            if UnitHasManagedAura(unit, definition.auras) then
                covered = covered + 1
            end
        end)
        local label = buffStatusLabels[definition.key]
        if label then
            local color = covered == total and "|cff33ff99" or "|cffffcc33"
            label:SetText(color .. covered .. "/" .. total .. "|r")
        end
    end
end

