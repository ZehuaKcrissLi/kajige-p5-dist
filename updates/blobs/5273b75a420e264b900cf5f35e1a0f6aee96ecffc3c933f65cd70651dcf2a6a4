            )
            return true
        end
    end
    Print("未知 P4 专精键：" .. tostring(specKey), true)
    return false
end

local function PanelButton(parent, text, x, y, width, action)
    local button = CreateFrame("Button", nil, parent, "UIPanelButtonTemplate")
    button:SetWidth(width or 118)
    button:SetHeight(24)
    button:SetPoint("TOPLEFT", parent, "TOPLEFT", x, y)
    button:SetText(text)
    button:SetScript("OnClick", action)
    return button
end

local function CommandButton(parent, text, x, y, width, command)
    return PanelButton(parent, text, x, y, width, function() Send(command) end)
end

local function Label(parent, text, y)
    local label = parent:CreateFontString(nil, "OVERLAY", "GameFontNormal")
    label:SetPoint("TOPLEFT", parent, "TOPLEFT", 20, y)
    label:SetText(text)
    return label
end

local function CloseControlSubPanel(childPanel)
    if childPanel then childPanel:Hide() end
    local returnPanel = table.remove(controlPanelStack)
    if returnPanel then returnPanel:Show() end
end

local function OpenControlSubPanel(toggleFunction, sourcePanel)
    if sourcePanel and sourcePanel:IsShown() then
        table.insert(controlPanelStack, sourcePanel)
        sourcePanel:Hide()
    end
    toggleFunction()
end

