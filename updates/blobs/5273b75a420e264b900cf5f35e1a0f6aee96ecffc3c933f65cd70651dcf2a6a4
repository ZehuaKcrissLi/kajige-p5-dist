local function GearEnhancementText(choice)
    local data = GearData()
    local details = {}
    if choice and choice.enchant and choice.enchant > 0 then
        local enchant = data.enchants and data.enchants[choice.enchant]
        local label = enchant and enchant.name or ("附魔 " .. choice.enchant)
        if enchant and enchant.stats and enchant.stats ~= "" then
            label = label .. "（" .. enchant.stats .. "）"
        end
        table.insert(details, label)
    end
    for _, gemID in ipairs(choice and choice.gems or {}) do
        local gem = data.gems and data.gems[gemID]
        local label = gem and gem.name or ("宝石 " .. gemID)
        if gem and gem.stats and gem.stats ~= "" then
            label = label .. "（" .. gem.stats .. "）"
        end
        table.insert(details, label)
    end
    return table.concat(details, " / ")
end

local function GearEnhancementSummary(choice)
    local labels = {}
    if choice and choice.enchant and choice.enchant > 0 then
        table.insert(labels, "附魔")
    end
    local gemCount = 0
    for _, gemID in ipairs(choice and choice.gems or {}) do
        if gemID and gemID > 0 then gemCount = gemCount + 1 end
    end
    if gemCount > 0 then
        table.insert(labels, gemCount .. "颗宝石")
    end
    return #labels > 0 and table.concat(labels, " + ") or "无强化"
end

