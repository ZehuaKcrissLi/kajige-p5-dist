    if gearBuildLabel then
        gearBuildLabel:SetText(
            template and (
                (spec and spec.name or gearSelectedSpecKey)
                .. " · " .. template.buildName
            ) or "请先选择左侧职业专精"
        )
    end
    for _, button in pairs(gearSpecButtons) do
        button:SetText(
            (button.specKey == gearSelectedSpecKey and "> " or "")
            .. button.specName
        )
    end
    for slot, button in pairs(gearSlotButtons) do
        local choice = gearDraft[slot]
        local item = choice and data.items and data.items[choice.id]
        local changed = template and not SameGearChoice(choice, template.gear[slot])
        button.choice = choice
        if choice and item then
            button.icon:SetTexture(ResolveGearItemIcon(choice.id, item))
            local r, g, b = GearQualityRGB(item.quality)
            if button.iconFrame and button.iconFrame.SetBackdropBorderColor then
                button.iconFrame:SetBackdropBorderColor(r, g, b, 1)
            end
            button.name:SetText(
                (changed and "|cffffcc00* " or "")
                .. QualityColor(item.quality)
                .. ShortText(item.name, 24) .. "|r"
            )
            button.detail:SetText(
                "|cffd0d0d0装等 " .. (item.itemLevel or 0)
                .. " · ID " .. choice.id
                .. " · " .. GearEnhancementSummary(choice) .. "|r"
            )
            for index = 1, 3 do
                local gemTexture = button.gems and button.gems[index]
                local gemID = choice.gems and choice.gems[index]
                if gemTexture and gemID and gemID > 0 then
                    gemTexture:SetTexture(ResolveGearItemIcon(gemID, data.gems and data.gems[gemID]))
                    gemTexture:Show()
                elseif gemTexture then
                    gemTexture:Hide()
                end
            end
            button:Enable()
        else
            button.icon:SetTexture("Interface\\Icons\\INV_Misc_QuestionMark")
            button.name:SetText("|cff888888空缺（点击选择）|r")
            button.detail:SetText("")
            for index = 1, 3 do
                if button.gems and button.gems[index] then
                    button.gems[index]:Hide()
                end
            end
            button:Enable()
        end
    end
    if gearApplyButton then
        if template then gearApplyButton:Enable() else gearApplyButton:Disable() end
    end
    if gearPreviewModel and gearPreviewModel.SetUnit then
        pcall(gearPreviewModel.SetUnit, gearPreviewModel, "player")
    end
    if gearPreviewModel and gearPreviewModel.TryOn then
        for _, slot in ipairs(gearSlots) do
            local choice = gearDraft[slot]
            if choice then
                pcall(gearPreviewModel.TryOn, gearPreviewModel, "item:" .. choice.id)
            end
        end
    end
end

