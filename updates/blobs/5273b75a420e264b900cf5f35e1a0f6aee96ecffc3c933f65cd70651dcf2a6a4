local function SelectCurrentGearTarget()
    if not IsLeaderOrGM() then
        gearTargetName = nil
        UpdateGearTargetLabel()
        Print("普通账号只能给自己换装。", true)
        return
    end
    if not UnitExists("target")
        or UnitIsUnit("target", "player")
        or not UnitIsPlayer("target") then
        Print("请先选中一个在线人类玩家或机器人。", true)
        return
    end
    gearTargetName = UnitName("target")
    UpdateGearTargetLabel()
end

local function ApplyGearDraft()
    local template = GearTemplate(gearSelectedSpecKey)
    if not template then
        Print("请先选择职业专精。", true)
        return
    end
    local overrides = {}
    local compact = {}
    for _, slot in ipairs(gearSlots) do
        local choice = gearDraft[slot]
        if choice and not SameGearChoice(choice, template.gear[slot]) then
            table.insert(overrides, slot .. ":" .. choice.id)
            table.insert(compact, tostring(choice.id))
        else
            table.insert(compact, "0")
        end
    end
    local targetMode = IsLeaderOrGM() and gearTargetName
    if #overrides > 0 then
        if targetMode then
            Send(
                ".kjg gear loadout player " .. gearTargetName .. " "
                .. gearPhase .. " " .. gearSelectedSpecKey .. " "
                .. table.concat(compact, ",")
            )
        else
            Send(
                ".kjg gear loadout self " .. gearPhase .. " "
                .. gearSelectedSpecKey .. " " .. table.concat(compact, ",")
            )
        end
    elseif targetMode then
        Send(
            ".kjg gear player " .. gearTargetName .. " "
            .. gearPhase .. " " .. gearSelectedSpecKey
        )
    else
        Send(".kjg gear self " .. gearPhase .. " " .. gearSelectedSpecKey)
    end
    Print("已提交整套配装；服务端会统一校验职业、候选池、附魔和宝石后应用。")
end

local function StripCurrentGearTarget()
    if IsLeaderOrGM() and gearTargetName then
        Send(".kjg gear strip player " .. gearTargetName)
    else
        Send(".kjg gear strip self")
    end
end

