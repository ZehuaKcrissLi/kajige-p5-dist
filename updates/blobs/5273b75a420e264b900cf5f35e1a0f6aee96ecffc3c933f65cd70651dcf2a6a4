local function ShowControlPage(key)
    if not panelPages[key] then key = "overview" end
    for pageKey, page in pairs(panelPages) do
        if pageKey == key then page:Show() else page:Hide() end
    end
    for pageKey, button in pairs(panelNavButtons) do
        if pageKey == key then button:Disable() else button:Enable() end
    end
    activePanelPage = key
    DB.controlPanelPage = key
    if panelBreadcrumb then
        panelBreadcrumb:SetText(
            "KJG 控制台  /  " .. panelPages[key].controlTitle
        )
    end
end

