local function SaveLauncherPosition()
    if not launcherButton then return end
    local point, _, relativePoint, x, y = launcherButton:GetPoint(1)
    if not point then return end
    DB.launcherPosition = {
        point = point,
        relativePoint = relativePoint or point,
        x = math.floor((x or 0) + 0.5),
        y = math.floor((y or 0) + 0.5),
    }
end

local function RestoreLauncherPosition()
    if not launcherButton then return end
    launcherButton:ClearAllPoints()
    local saved = DB.launcherPosition
    if type(saved) == "table" and saved.point and saved.relativePoint then
        launcherButton:SetPoint(
            saved.point,
            UIParent,
            saved.relativePoint,
            tonumber(saved.x) or 0,
            tonumber(saved.y) or 0
        )
    else
        launcherButton:SetPoint("TOPRIGHT", UIParent, "TOPRIGHT", -210, -36)
    end
end

local function BuildLauncherButton()
    if launcherButton then
        launcherButton:Show()
        return
    end
    launcherButton = CreateFrame(
        "Button",
        "KajigeSWTLauncherButton",
        UIParent,
        "UIPanelButtonTemplate"
    )
    launcherButton:SetWidth(150)
    launcherButton:SetHeight(28)
    launcherButton:SetFrameStrata("DIALOG")
    launcherButton:SetMovable(true)
    launcherButton:SetClampedToScreen(true)
    launcherButton:EnableMouse(true)
    launcherButton:RegisterForDrag("LeftButton")
    RestoreLauncherPosition()
    launcherButton:SetText("KJG 训练控制台")
    launcherButton:SetScript("OnDragStart", function(self)
        self.justDragged = true
        self:StartMoving()
    end)
    launcherButton:SetScript("OnDragStop", function(self)
        self:StopMovingOrSizing()
        SaveLauncherPosition()
        self.dragClearElapsed = 0
        self:SetScript("OnUpdate", function(button, elapsed)
            button.dragClearElapsed = button.dragClearElapsed + elapsed
            if button.dragClearElapsed >= 0.2 then
                button.justDragged = nil
                button:SetScript("OnUpdate", nil)
            end
        end)
    end)
    launcherButton:SetScript("OnClick", function(self)
        if self.justDragged then return end
        TogglePanel()
    end)
    launcherButton:SetScript("OnEnter", function(self)
        GameTooltip:SetOwner(self, "ANCHOR_BOTTOM")
        GameTooltip:SetText(
            "点击打开 KJG 控制台；按住左键拖动可移动，位置会自动保存。",
            1,
            1,
            1
        )
        GameTooltip:Show()
    end)
    launcherButton:SetScript("OnLeave", function() GameTooltip:Hide() end)
end

local function LockOriginalPanel()
    if SunwellTrainerPanel then
        SunwellTrainerPanel:Hide()
        SunwellTrainerPanel:SetScript("OnShow", function(self)
            self:Hide()
        end)
    end
    if SunwellTrainerBotSpecPanel then SunwellTrainerBotSpecPanel:Hide() end
    SlashCmdList.SUNWELLTRAINER = TogglePanel
end

frame:RegisterEvent("PLAYER_LOGIN")
frame:RegisterEvent("CHAT_MSG_SYSTEM")
frame:RegisterEvent("RAID_ROSTER_UPDATE")
frame:RegisterEvent("PARTY_MEMBERS_CHANGED")
if type(ChatFrame_AddMessageEventFilter) == "function" then
    ChatFrame_AddMessageEventFilter("CHAT_MSG_SYSTEM", PermissionChatFilter)
end
frame:SetScript("OnEvent", function(_, event, message)
    if event == "CHAT_MSG_SYSTEM" then
        if HandlePermissionMessage(message) then return end
        if IsPermissionProtocolMessage(message) then return end
        if message and string.find(message, "^KJG召集邀请：") then
            StaticPopup_Show("KAJIGE_SUMMON_CONFIRM", message)
        end
        return
    end
    if event == "RAID_ROSTER_UPDATE" or event == "PARTY_MEMBERS_CHANGED" then
        if UpdateRosterStatus then UpdateRosterStatus() end
        return
    end
    LockOriginalPanel()
    pcall(SetCVar, "cameraDistanceMaxFactor", "2.6")
    BuildPermissionMenuButton()
    QueueCommand(".kjg permission")
    if DB.fastRun then
        QueueCommand(".kjg self speed on")
    end
    -- Every account now has personal movement tools, so the launcher is
    -- shown to all players; non-staff accounts open the personal panel.
    BuildLauncherButton()
    Print("KJG 控制台已就绪，点击右上角按钮或输入 /kjg 打开。")
end)

