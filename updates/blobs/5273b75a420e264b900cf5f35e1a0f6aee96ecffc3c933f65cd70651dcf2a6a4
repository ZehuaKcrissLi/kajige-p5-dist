local function ResolveGearItemIcon(itemID, item)
    local icon
    if GetItemIcon then
        local ok, result = pcall(GetItemIcon, itemID)
        if ok and type(result) == "string" and result ~= "" then
            icon = result
        end
    end
    if not icon and GetItemInfo then
        local values = {pcall(GetItemInfo, itemID)}
        local result = values[11]
        if values[1] and type(result) == "string" and result ~= "" then
            icon = result
        end
    end
    if not icon and item and type(item.icon) == "string" then
        icon = item.icon
    end
    return icon or "Interface\\Icons\\INV_Misc_QuestionMark"
end

