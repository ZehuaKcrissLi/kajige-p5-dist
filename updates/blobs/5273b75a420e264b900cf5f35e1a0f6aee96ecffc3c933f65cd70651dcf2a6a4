local function CreateGearSlotButton(parent, slot, x, y, width, side)
    local button = CreateFrame("Button", nil, parent)
    width = width or 190
    side = side or "left"
    button:SetWidth(width)
    button:SetHeight(48)
    button:SetPoint("TOPLEFT", parent, "TOPLEFT", x, y)
    button:SetText("")
    button.gearSlotID = slot
    ApplyGearBackdrop(button, gearUI.card, gearUI.border, 8)

    button.iconFrame = CreateFrame("Frame", nil, button)
    button.iconFrame:SetWidth(42)
    button.iconFrame:SetHeight(42)
    if side == "right" then
        button.iconFrame:SetPoint("RIGHT", button, "RIGHT", -3, 0)
    else
        button.iconFrame:SetPoint("LEFT", button, "LEFT", 3, 0)
    end
    ApplyGearBackdrop(button.iconFrame, gearUI.background, gearUI.border, 7)
    button.icon = button.iconFrame:CreateTexture(nil, "ARTWORK")
    button.icon:SetWidth(40)
    button.icon:SetHeight(40)
    button.icon:SetPoint("CENTER", button.iconFrame, "CENTER", 0, 0)

    button.slot = button:CreateFontString(nil, "OVERLAY", "GameFontNormalSmall")
    button.slot:SetText("|cff33ff99" .. gearSlotNames[slot] .. "|r")
    button.name = button:CreateFontString(nil, "OVERLAY", "GameFontNormalSmall")
    button.name:SetWidth(width - 88)
    button.name:SetHeight(15)
    button.detail = button:CreateFontString(nil, "OVERLAY", "GameFontHighlightSmall")
    button.detail:SetWidth(width - 52)
    button.detail:SetHeight(14)

    if side == "right" then
        button.slot:SetPoint("TOPRIGHT", button, "TOPRIGHT", -50, -5)
        button.name:SetPoint("RIGHT", button.slot, "LEFT", -5, 0)
        button.name:SetJustifyH("RIGHT")
        button.detail:SetPoint("BOTTOMRIGHT", button, "BOTTOMRIGHT", -50, 7)
        button.detail:SetJustifyH("RIGHT")
    else
        button.slot:SetPoint("TOPLEFT", button, "TOPLEFT", 50, -5)
        button.name:SetPoint("LEFT", button.slot, "RIGHT", 5, 0)
        button.name:SetJustifyH("LEFT")
        button.detail:SetPoint("BOTTOMLEFT", button, "BOTTOMLEFT", 50, 7)
        button.detail:SetJustifyH("LEFT")
    end

    button.gems = {}
    for index = 1, 3 do
        local gem = button.iconFrame:CreateTexture(nil, "OVERLAY")
        gem:SetWidth(11)
        gem:SetHeight(11)
        gem:SetPoint("BOTTOMLEFT", button.iconFrame, "BOTTOMLEFT", 3 + (index - 1) * 12, 3)
        gem:Hide()
        button.gems[index] = gem
    end

    button:SetScript("OnClick", function()
        if not gearSelectedSpecKey then
            Print("请先选择左侧职业专精。", true)
            return
        end
        ShowGearCatalog(gearSelectedSpecKey, slot, 1)
    end)
    button:SetScript("OnEnter", function(self)
        if not self.choice then return end
        SetGearBackdropColors(self, gearUI.cardHover, gearUI.gold)
        ShowGearChoiceTooltip(self, self.choice, slot)
    end)
    button:SetScript("OnLeave", function(self)
        SetGearBackdropColors(self, gearUI.card, gearUI.border)
        GameTooltip:Hide()
    end)
    gearSlotButtons[slot] = button
end

