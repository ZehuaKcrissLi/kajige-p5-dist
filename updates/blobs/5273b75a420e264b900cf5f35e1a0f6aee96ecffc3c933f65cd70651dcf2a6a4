local function ApplyPermissionState(tag, security, mask)
    permissionState.tag = tag or "PLAYER"
    permissionState.security = tonumber(security) or 0
    permissionState.mask = tonumber(mask) or 0
    permissionState.verified = true
    DB.permissionTag = permissionState.tag
    DB.permissionSecurity = permissionState.security
    DB.permissionMask = permissionState.mask
    DB.permissionVerified = true
    if type(RegisterCVar) == "function" then
        pcall(RegisterCVar, "KajigePermissionTag", "尚未验证")
    end
    if type(SetCVar) == "function" then
        pcall(SetCVar, "KajigePermissionTag", permissionState.tag)
    end
    UpdatePermissionUI()
end

local function HandlePermissionMessage(message)
    local tag, security, mask = string.match(
        message or "",
        "^KJG_PERMISSION:([A-Z0-9%-]+):(%d+):(%d+)$"
    )
    if not tag then return false end
    ApplyPermissionState(tag, security, mask)
    return true
end

local function IsPermissionProtocolMessage(message)
    return string.find(message or "", "^KJG_PERMISSION:") ~= nil
        or string.find(message or "", "^KJG权限") ~= nil
end

-- The server reports the fast-run switch so it can be restored after the
-- next login; the protocol line itself stays out of chat.
local function HandleFastRunMessage(message)
    local state = string.match(message or "", "^KJG_FASTRUN:(%a+)$")
    if not state then return false end
    DB.fastRun = state == "on"
    return true
end

local function PermissionChatFilter(_, _, message)
    if HandleFastRunMessage(message) then
        return true
    end
    if HandlePermissionMessage(message) then
        return true
    end
    -- Older servers used raw pipe separators. WoW 3.3.5 interprets |G and
    -- |3 as layout control sequences, corrupting the payload before Lua sees
    -- it. Hide those unusable legacy replies instead of leaking them to chat.
    return IsPermissionProtocolMessage(message)
end

