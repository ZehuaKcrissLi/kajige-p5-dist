  pos=pos+1; local out={}
  while pos<=#s do local c=s:sub(pos,pos); pos=pos+1
   if c=='"' then return table.concat(out) elseif c=='\\' then
    c=s:sub(pos,pos);pos=pos+1;local esc={n='\n',r='\r',t='\t',b='\b',f='\f',['"']='"',['\\']='\\',['/']='/'}
    if c=='u' then local n=tonumber(s:sub(pos,pos+3),16);assert(n,'invalid unicode');pos=pos+4
     if n<128 then c=string.char(n) elseif n<2048 then c=string.char(192+math.floor(n/64),128+n%64) else c=string.char(224+math.floor(n/4096),128+math.floor(n/64)%64,128+n%64) end
    else c=assert(esc[c],'invalid escape') end
   end;out[#out+1]=c
  end;error('unterminated JSON string')
 end
 parse=function() ws();local c=s:sub(pos,pos)
  if c=='"' then return str() elseif c=='{' or c=='[' then
   local obj,close={},c=='{' and '}' or ']';pos=pos+1;ws();if s:sub(pos,pos)==close then pos=pos+1;return obj end
   while true do local k;if c=='{' then ws();assert(s:sub(pos,pos)=='"');k=str();ws();assert(s:sub(pos,pos)==':');pos=pos+1 else k=#obj+1 end
    obj[k]=parse();ws();local sep=s:sub(pos,pos);pos=pos+1;if sep==close then break end;assert(sep==',','invalid separator') end;return obj
  elseif s:sub(pos,pos+3)=='true' then pos=pos+4;return true elseif s:sub(pos,pos+4)=='false' then pos=pos+5;return false elseif s:sub(pos,pos+3)=='null' then pos=pos+4;return nil
  else local n=s:match('^-?%d+%.?%d*[eE]?[+-]?%d*',pos);assert(n and tonumber(n),'invalid number');pos=pos+#n;return tonumber(n) end
 end
 local result=parse();ws();assert(pos>#s,'trailing JSON');return result
end
