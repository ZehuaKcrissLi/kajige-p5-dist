  local co,si=math.cos(-angle),math.sin(-angle)
  local function uv(x,y)return .5+x*co-y*si,.5+x*si+y*co end
  local ulx,uly=uv(-.5,-.5);local llx,lly=uv(-.5,.5);local urx,ury=uv(.5,-.5);local lrx,lry=uv(.5,.5)
