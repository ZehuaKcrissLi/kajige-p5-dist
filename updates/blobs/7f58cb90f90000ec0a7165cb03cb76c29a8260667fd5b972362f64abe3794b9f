 elseif t=='table' then local r={} local array=#v>0; if array then for i,x in ipairs(v) do r[#r+1]=C.Encode(x) end else for k,x in pairs(v) do r[#r+1]=C.Encode(tostring(k))..':'..C.Encode(x) end end; return (array and '[' or '{')..table.concat(r,',')..(array and ']' or '}') end
 error('unsupported JSON value')
end
function C.Decode(s)
