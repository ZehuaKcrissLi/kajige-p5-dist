local events = CreateFrame("Frame")
events:RegisterEvent("CHAT_MSG_SYSTEM"); events:RegisterEvent("CHAT_MSG_ADDON"); events:RegisterEvent("PLAYER_LOGIN"); events:RegisterEvent("PLAYER_ENTERING_WORLD"); events:RegisterEvent("PLAYER_TARGET_CHANGED")
events:SetScript("OnEvent", function(_, event, text, message, channel, sender)
    if event == "PLAYER_LOGIN" then
        LoadHistory(); activeID=nil; reply=""; busy=false; queue={}; Render()
        if ui and ui:IsShown() then Send(".kjai status") end
        return
    end
    if event == "PLAYER_ENTERING_WORLD" then
        LoadHistory(); Render()
        if ui then ui.context:SetText(Context()) end
        if ui and ui:IsShown() then Send(".kjai status") end
        return
    end
    if event == "PLAYER_TARGET_CHANGED" then if ui then ui.context:SetText(Context()) end return end
    if event == "CHAT_MSG_ADDON" then
        if text ~= "AzerothCore" or channel ~= "WHISPER" or type(message) ~= "string" then return end
        if type(sender) ~= "string" or sender:match("^[^-]+") ~= UnitName("player") then return end
        local opcode, sequence, body = message:match("^([amof])(%d%d%d%d)(.*)$")
        local sent = sequence and sentCommands[sequence]
        if not sent or GetTime()-sent.at > 240 then return end
        if sent.native then
            if opcode=="m" or opcode=="f" then
                local feedback=opcode=="f" and "服务器拒绝了该命令，请检查权限和参数。" or Clean(body)
                Add("创作执行反馈",feedback)
                if DEFAULT_CHAT_FRAME then DEFAULT_CHAT_FRAME:AddMessage("|cff5ce2d3[创作]|r "..feedback) end
            end
            return
        end
        if opcode == "f" and busy then
            busy=false; activeID=nil; reply=""; queue={}
            Add("提示", "请求未提交成功，请重新发送。")
        end
        if opcode ~= "m" then return end
        text = body
    end
    if type(text) ~= "string" then return end
    local id = text:match("^KJG_AI_BEGIN:([^:]+)$")
    if id then
        if activeID ~= id then activeID=id; reply=""; sentAt=GetTime() end
        busy=true; Render(); return
    end
    local kind, responseID, value = text:match("^KJG_AI_(%u+):([^:]+):(.*)$")
    if kind == "CLIENT" and responseID == activeID then clientReply=(clientReply or "")..value;return end
    if (kind == "TEXT" or kind == "ACTION") and responseID == activeID then
        if kind == "TEXT" then reply = (reply or "") .. Clean(value); if #reply > 24000 then reply=reply:sub(1,24000) end
        else Add("执行反馈", value) end
        Render(); return
    end
    id = text:match("^KJG_AI_END:([^:]+)$")
    if id and id == activeID then
        if KajigeCreative and clientReply and clientReply~="" then
            local ok,list=pcall(KajigeCreative.Decode,clientReply)
            if ok and type(list)=="table" then
                for _,a in ipairs(list) do
                    if a.type=="settings" then
                        local yes,p=pcall(KajigeCreative.Decode,a.payload_json or "{}")
                        if yes and type(p)=="table" then
                            if type(p.models)=="table" then store.models=p.models end
                            if type(p.projects)=="table" then store.projects=p.projects end
                            if type(p.selected_project)=="string" then
                                for _,project in ipairs(store.projects or {}) do
                                    local id=type(project)=="table" and project.id or project
                                    if id==p.selected_project then session.project=id;break end
                                end
                            end
                        end
                    elseif a.type=="macro" or a.type=="map" or a.type=="script" then actions[#actions+1]=a;session.actions=actions end
                end
            else Add("提示","作品数据未完整收到，请让助手重新生成。") end
        end
        local final = reply; busy=false; activeID=nil; reply=""
        if final and final ~= "" then Add("咔鸡 AI", final) else Render() end
        return
    end
    value = text:match("^KJG_AI_STATUS:(.*)$")
    if value then
        if value:find("对话记忆已清空",1,true) or value:find("请求已取消",1,true) then
            busy=false; activeID=nil; reply=""
        end
        if value:find("{",1,true) then
            serviceStatus = value:find("离线",1,true) and "助手暂不可用，请稍后重试" or "助手已连接"
        elseif value:find("伙伴",1,true) then serviceStatus = Clean(value)
        elseif value:find("codex",1,true) or value:find("助手",1,true) then serviceStatus = Clean(value)
        end
        Render(); return
    end
    value = text:match("^KJG_AI_ERROR:(.*)$")
    if value then busy=false; activeID=nil; reply=""; queue={}; Add("请求失败", value) end
end)
events:SetScript("OnUpdate", function(_, delta)
    if ui and ui:IsShown() and KajigeCreative then
        navElapsed=navElapsed+delta
        if navElapsed>.5 then navElapsed=0;ui.navigation:SetText(KajigeCreative.Navigation() or "");KajigeCreative.RefreshPins() end
    end
    elapsed=elapsed+delta
    if elapsed >= 0.08 and #queue > 0 then
        elapsed=0; counter=(counter+1)%10000
        local command=table.remove(queue,1)
        sentCommands[string.format("%04d",counter)] = {at=GetTime(),command=command,native=not command:match("^%.kjai[%s]")}
        for sequence, sent in pairs(sentCommands) do if GetTime()-sent.at > 240 then sentCommands[sequence]=nil end end
        if type(SendAddonMessage)=="function" then SendAddonMessage("AzerothCore", "h" .. string.format("%04d",counter) .. command:gsub("^[.!]", ""), "WHISPER", UnitName("player"))
        else SendChatMessage(command,"SAY") end
    end
    if busy and sentAt and GetTime()-sentAt > 200 then
        busy=false; activeID=nil; reply=""; queue={}; Send(".kjai cancel"); Add("提示", "等待超时，已请求取消；请查看服务状态后重试。"); Send(".kjai status")
    end
end)
