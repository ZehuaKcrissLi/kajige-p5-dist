local function Submit(text)
    text = Clean(text):gsub("\r", ""):gsub("\n", " "):gsub("^%s+", ""):gsub("%s+$", "")
    if text == "" then return false end
    if busy then Add("提示", "上一条请求仍在处理，可以先取消。") return false end
    if #text > 8192 then Add("提示", "内容过长，请缩短后发送（最多 8192 字节）。") return false end
    tokenCounter = tokenCounter + 1
    local token = "k" .. tostring(math.floor(GetTime()*1000)) .. "x" .. tokenCounter
    busy, activeID, reply, sentAt = true, nil, "", GetTime()
    Add("你", text)
    if KajigeCreative then
        local context=KajigeCreative.Context();context.attachments=attachments
        local payload=KajigeCreative.Encode({message=text,session=session.id,model=session.model,project=session.project,agent=session.agent,context=context})
        if #payload>24576 then context.bags={};payload=KajigeCreative.Encode({message=text,session=session.id,model=session.model,project=session.project,agent=session.agent,context=context}) end
        if #payload>24576 then busy=false;Add("提示","上下文过大，请缩短内容或清除附加资料。");return false end
        text=payload;attachments={}
    end
    clientReply=""
    Send(".kjai start " .. token)
    for _, chunk in ipairs(Chunks(text, 150)) do Send(".kjai part " .. token .. " " .. chunk) end
    Send(".kjai submit " .. token)
    return true
end
