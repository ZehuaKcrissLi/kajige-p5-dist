local function RegisterMedia()
    local media = LibStub and LibStub("LibSharedMedia-3.0", true)
    if media then
        -- Every embedded LSM copy shares this LibStub singleton. Correct the
        -- live table as a final defense against addon load order, then use an
        -- all-locale mask because legacy LSM rejects unmasked zhCN fonts.
        if type(media.MediaTable) == "table" then
            media.MediaTable.font = media.MediaTable.font or {}
            media.MediaTable.font["伤害数字"] = "Fonts\\ARKai_C.ttf"
            media.MediaTable.font["默认"] = "Fonts\\ARKai_T.ttf"
            media.MediaTable.font["聊天"] = "Fonts\\ARHei.ttf"
            media.MediaTable.font["Rurutia"] = RURUTIA_FONT_PATH
        end
        if type(media.DefaultMedia) == "table" then
            media.DefaultMedia.font = "默认"
        end
        if type(media.Register) == "function" then
            pcall(media.Register, media, "font", "Rurutia", RURUTIA_FONT_PATH, 255)
        end
        loadAudit.mediaTableFixed = true
    end
end

local function MergeKnownSections(target, source, defaults)
    for key, value in pairs(source or {}) do
        if key == "movers" or (defaults and defaults[key] ~= nil) then
            if type(value) == "table" then
                if type(target[key]) ~= "table" then
                    target[key] = {}
                end
                Merge(target[key], value)
            else
                target[key] = value
            end
        end
    end
end

local function ApplyElvUI()
    if type(ElvUI) ~= "table" or type(SunwellLuluElvProfile) ~= "table" then
        return false, "ElvUI 尚未就绪"
    end

    local E = unpack(ElvUI)
    if not E or not E.data or not E.DF then
        return false, "ElvUI 数据库尚未就绪"
    end

    RegisterMedia()

    local profile = DeepCopy(E.DF.profile)
    MergeKnownSections(profile, SunwellLuluElvProfile, E.DF.profile)
    SanitizeElvTags(profile)
    ApplyTitanCompatibilityProfile(profile)
    NormalizeMedia(profile)

    local global = {}
    MergeKnownSections(global, SunwellLuluElvGlobal, E.DF.global)
    NormalizeMedia(global)
    Merge(E.data.global, global)

    if E.data:GetCurrentProfile() == PROFILE_NAME and type(E.data.profile) == "table" then
        local activeProfile = E.data.profile
        wipe(activeProfile)
        Merge(activeProfile, profile)
        E.data.profiles[PROFILE_NAME] = activeProfile
    else
        E.data.profiles[PROFILE_NAME] = profile
        E.data:SetProfile(PROFILE_NAME)
    end
    E.db = E.data.profile
    E.global = E.data.global
    InstallLegacyIndexSort(E)
    E:UpdateAll(true)
    return true
end

