            and type(WeakAuras.Delete) == "function"
            and WeakAuras.regions
            and WeakAuras.regions[id]
            and WeakAuras.regions[id].region then
            pcall(WeakAuras.Delete, data)
        end
        WeakAurasSaved.displays[id] = nil
    end
    return #remove
