local function SpellName(spellId)
    local name = GetSpellInfo(spellId)
    return name
end

local function MacroLine(spellId)
    local name = SpellName(spellId)
    return name and ("/cast " .. name) or nil
end

local function CreateOrUpdateMacro(definition)
    local body = definition.body
    if type(body) == "function" then
        body = body()
    end
    if not body or body == "" then
        return nil
    end

    if string.len(body) > 255 then
        body = string.sub(body, 1, 255)
    end

    local index = GetMacroIndexByName(definition.name)
    if index and index > 0 then
        EditMacro(index, definition.name, definition.icon or 1, body, 1)
        return index
    end
    return CreateMacro(definition.name, definition.icon or 1, body, 1)
end

local function CombatMacro(spellId, petAttack)
    local spell = SpellName(spellId)
    if not spell then
        return nil
    end
    local lines = { "#showtooltip " .. spell }
    if petAttack then
        lines[#lines + 1] = "/petattack [harm,nodead]"
    else
        lines[#lines + 1] = "/startattack"
    end
    lines[#lines + 1] = "/cast " .. spell
    return table.concat(lines, "\n")
end

