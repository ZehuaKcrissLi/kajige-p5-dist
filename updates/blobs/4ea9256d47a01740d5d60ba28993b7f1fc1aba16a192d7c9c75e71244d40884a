local hiddenEnglishSystemMessages = {
    "Welcome to an AzerothCore server",
    "This server runs on AzerothCore",
    "This server runs with.*mod%-playerbots",
    "Playerbots:.*configured with",
}

local function ChineseSystemMessageFilter(_, _, message, ...)
    if type(message) ~= "string" then
        return false, message, ...
    end
    for _, pattern in ipairs(hiddenEnglishSystemMessages) do
        if string.find(message, pattern) then
            return true
        end
    end

    local translated = message
    translated = string.gsub(translated, "Joined Channel:", "已加入频道：")
    translated = string.gsub(translated, "Left Channel:", "已离开频道：")
    translated = string.gsub(translated, "General", "综合")
    translated = string.gsub(translated, "LocalDefense", "本地防务")
    for english, chinese in pairs(zoneTranslations) do
        translated = string.gsub(translated, english, chinese)
    end
    return false, translated, ...
end

