local function ClearActionBars()
    if not PickupAction or not ClearCursor then
        return
    end
    for slot = 1, 72 do
        PickupAction(slot)
        ClearCursor()
    end
end

local function PlaceMacro(index, slot)
    if not index or index <= 0 then
        return
    end
    PickupMacro(index)
    PlaceAction(slot)
    ClearCursor()
end

local function FillGenericSpellBar()
    if not GetSpellName or not PickupSpell then
        return
    end
    local actionSlot = 1
    local spellBookSlot = 1
    while actionSlot <= 12 do
        local name = GetSpellName(spellBookSlot, BOOKTYPE_SPELL)
        if not name then
            break
        end
        if not IsPassiveSpell(spellBookSlot, BOOKTYPE_SPELL) then
            PickupSpell(spellBookSlot, BOOKTYPE_SPELL)
            PlaceAction(actionSlot)
            ClearCursor()
            actionSlot = actionSlot + 1
        end
        spellBookSlot = spellBookSlot + 1
    end
end

local function ApplyMacrosAndBars(classToken)
    if InCombatLockdown and InCombatLockdown() then
        return false
    end

    ClearActionBars()
    local builder = classMacroBuilders[classToken]
    if not builder then
        FillGenericSpellBar()
        return true
    end

    local indices = {}
    local definitions = builder()
    for position, definition in ipairs(definitions) do
        indices[position] = CreateOrUpdateMacro(definition)
        PlaceMacro(indices[position], position)
    end

    if classToken == "WARLOCK" then
        local extraSlots = {
            [1] = 64, [2] = 62, [3] = 65, [4] = 63, [5] = 66, [6] = 52,
            [8] = 57, [9] = 49, [10] = 51, [11] = 55, [12] = 60,
        }
        for macroIndex, slot in pairs(extraSlots) do
            PlaceMacro(indices[macroIndex], slot)
        end
    elseif classToken == "PALADIN" then
        local extraSlots = { [1] = 49, [2] = 50, [3] = 51, [4] = 52, [5] = 53, [6] = 54 }
        for macroIndex, slot in pairs(extraSlots) do
            PlaceMacro(indices[macroIndex], slot)
        end
    end
    return true
end

local function ApplyBindings(classToken)
    if not SetBinding or not SaveBindings then
        return
    end

    local common = {
        { "A", "STRAFELEFT" },
        { "D", "STRAFERIGHT" },
        { "CTRL-W", "STARTAUTORUN" },
        { "ALT-1", "MULTIACTIONBAR1BUTTON1" },
        { "ALT-2", "MULTIACTIONBAR2BUTTON2" },
        { "ALT-3", "ACTIONBUTTON7" },
        { "ALT-4", "MULTIACTIONBAR2BUTTON4" },
        { "SHIFT-H", "ELVUIBAR6BUTTON5" },
    }
    for _, binding in ipairs(common) do
        SetBinding(binding[1], binding[2])
    end

    if classToken == "WARLOCK" or classToken == "ROGUE" then
        local bindings = {
            { "Q", "MULTIACTIONBAR2BUTTON1" },
            { "E", "MULTIACTIONBAR1BUTTON2" },
            { "R", "MULTIACTIONBAR1BUTTON3" },
            { "F", "MULTIACTIONBAR1BUTTON4" },
            { "Z", "MULTIACTIONBAR1BUTTON5" },
            { "X", "MULTIACTIONBAR1BUTTON6" },
            { "G", "MULTIACTIONBAR2BUTTON4" },
            { "SHIFT-F", "MULTIACTIONBAR2BUTTON3" },
            { "SHIFT-A", "MULTIACTIONBAR2BUTTON8" },
            { "SHIFT-E", "MULTIACTIONBAR2BUTTON9" },
            { "SHIFT-V", "MULTIACTIONBAR2BUTTON10" },
            { "SHIFT-X", "MULTIACTIONBAR2BUTTON11" },
            { "SHIFT-C", "MULTIACTIONBAR2BUTTON12" },
        }
        for _, binding in ipairs(bindings) do
            SetBinding(binding[1], binding[2])
        end
    elseif classToken == "PALADIN" then
        for index = 1, 8 do
            SetBinding("SHIFT-" .. index, "MULTIACTIONBAR2BUTTON" .. index)
        end
    end
    SaveBindings(2)
end

local function CurrentCharacterKey()
    local name = type(UnitName) == "function" and UnitName("player")
    local realm = type(GetRealmName) == "function" and GetRealmName()
    if type(name) ~= "string" or name == ""
        or type(realm) ~= "string" or realm == "" then
        return nil
    end
    return name .. " - " .. realm
end

local function ApplyUIOnly(force)
    local characterKey = CurrentCharacterKey()
    if not characterKey then
        return false, false, "CHARACTER_NOT_READY"
    end
    local characterVersion = SunwellLuluProfileDB.characters[characterKey]
    local needsCharacterApply = force or characterVersion ~= PROFILE_VERSION

    if not needsCharacterApply then
        return true, false
    end

    ApplyLayoutCVars()
    RegisterMedia()

    local elvOk, elvApplied, elvError = pcall(ApplyElvUI)
    if not elvOk then
        Print("界面配置导入失败，请重载界面后重试。")
        return false, false, "ELVUI_CALL_FAILED: " .. tostring(elvApplied)
    elseif not elvApplied then
        Print(elvError or "界面配置尚未应用，请确认统一界面插件已启用。")
        return false, false, elvError or "ELVUI_NOT_READY"
    end

    local detailsOk, detailsApplied = pcall(ApplyDetails)
    if not detailsOk then
        Print("战斗统计配置导入失败；界面布局仍已应用。")
    elseif not detailsApplied then
        Print("战斗统计插件未启用；不影响露露界面布局。")
    end

    local dbmOk = pcall(ApplyDBM)
    if not dbmOk then
        Print("首领提示字体配置导入失败；界面布局仍已应用。")
    end

    -- Commit the per-character version only after the safe visual migration
    -- has succeeded. No action slots, macros, bindings or WeakAuras are touched.
    SunwellLuluProfileDB.characters[characterKey] = PROFILE_VERSION
    SunwellLuluProfileDB.version = PROFILE_VERSION
    SunwellLuluProfileDB.profileName = PROFILE_NAME
    SunwellLuluProfileDB.loadAudit.applied = true
    SunwellLuluProfileDB.loadAudit.characterVersion = PROFILE_VERSION
    SunwellLuluProfileDB.loadAudit.detailsApplied = detailsOk and detailsApplied or false
    SunwellLuluProfileDB.loadAudit.dbmApplied = dbmOk
    SunwellLuluProfileDB.loadAudit.queued = false
    SunwellLuluProfileDB.loadAudit.phase = "APPLIED"
    SunwellLuluProfileDB.loadAudit.lastError = nil
    collectgarbage("collect")
    Print("已应用露露 25 人界面、现代粗体字体、战斗统计与首领提示；动作槽和按键未改动。")
    return true, true
end

local function QueueMigration(force, source)
    -- Do not read the character key during PLAYER_LOGIN. The legacy client can
    -- still be initializing its unit/realm state while a LoadOnDemand addon is
    -- loaded from another addon's event handler.
    pending = true
    elapsed = 0
    migrationAttempts = 0
    loadAudit.queued = true
    loadAudit.force = force and true or false
    loadAudit.source = tostring(source or "external")
    loadAudit.phase = "QUEUED"
    loadAudit.lastError = nil
    return true
end

SunwellLuluProfile_QueueMigration = QueueMigration

frame:RegisterEvent("PLAYER_LOGIN")
frame:RegisterEvent("PLAYER_REGEN_ENABLED")
pcall(RegisterMedia)
SuppressSetupWizards()
frame:SetScript("OnEvent", function(_, event)
    if event == "PLAYER_LOGIN" then
        local queueOk, queueError = pcall(QueueMigration, false, "PLAYER_LOGIN")
        if not queueOk then
            loadAudit.phase = "QUEUE_CALL_FAILED"
            loadAudit.lastError = tostring(queueError)
        end
        setupGuardRemaining = 30
        setupGuardElapsed = 0
        clearLoginChat = false
    elseif event == "PLAYER_REGEN_ENABLED" and pending then
        elapsed = 0
    end
end)
frame:SetScript("OnUpdate", function(_, delta)
    -- Migration is the primary state machine. Optional visual refreshes below
    -- are isolated so they can never prevent ApplyUIOnly from running.
    if pending then
        elapsed = elapsed + delta
        if elapsed >= 4
            and not (InCombatLockdown and InCombatLockdown()) then
            pending = false
            migrationAttempts = migrationAttempts + 1
            loadAudit.attempts = migrationAttempts
            loadAudit.phase = "APPLYING"
            local callOk, applied, changed, reason = pcall(ApplyUIOnly, false)
            if not callOk then
                loadAudit.phase = "APPLY_CALL_FAILED"
                loadAudit.lastError = tostring(applied)
            elseif not applied then
                loadAudit.phase = "RETRY_WAIT"
                loadAudit.lastError = tostring(reason or "APPLY_DEFERRED")
            end
            if (not callOk or not applied) and migrationAttempts < 6 then
                pending = true
                elapsed = 0
                loadAudit.queued = true
            elseif not callOk or not applied then
                loadAudit.queued = false
                loadAudit.phase = "FAILED"
            else
                loadAudit.queued = false
            end
        end
    end

    chineseUiElapsed = chineseUiElapsed + delta
    if chineseUiElapsed >= 0.5 then
        chineseUiElapsed = 0
        local visibleOk, visibleError = pcall(ApplyVisibleChinese)
        loadAudit.visibleChineseOk = visibleOk and true or false
        if not visibleOk then
            loadAudit.visibleChineseError = tostring(visibleError)
        end
    end

    if setupGuardRemaining > 0 then
        setupGuardRemaining = setupGuardRemaining - delta
        setupGuardElapsed = setupGuardElapsed + delta
        if setupGuardElapsed >= 0.5 then
            setupGuardElapsed = 0
            local setupOk, setupError = pcall(SuppressSetupWizards)
            loadAudit.setupGuardOk = setupOk and true or false
            if not setupOk then
                loadAudit.setupGuardError = tostring(setupError)
            end
        end
    end
end)

SLASH_SUNWELLLULU1 = "/lulu"
SlashCmdList.SUNWELLLULU = function(message)
    message = string.lower(message or "")
    if message == "apply" or message == "应用"
        or message == "reset" or message == "重置" then
        if InCombatLockdown and InCombatLockdown() then
            Print("请脱离战斗后再应用界面配置。")
            return
        end
        pending = false
        migrationAttempts = 0
        ApplyUIOnly(true)
        return
    end

    Print("配置版本 " .. DISPLAY_VERSION .. "；输入 /lulu apply 可安全应用露露 25 人界面。")
end
