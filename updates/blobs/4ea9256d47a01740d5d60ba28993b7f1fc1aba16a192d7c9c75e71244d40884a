local function DeepCopy(source, seen)
    if type(source) ~= "table" then
        return source
    end

    seen = seen or {}
    if seen[source] then
        return seen[source]
    end

    local target = {}
    seen[source] = target
    for key, value in pairs(source) do
        target[DeepCopy(key, seen)] = DeepCopy(value, seen)
    end
    return target
end

local function Merge(target, source)
    if type(target) ~= "table" or type(source) ~= "table" then
        return
    end

    for key, value in pairs(source) do
        if type(value) == "table" then
            if type(target[key]) ~= "table" then
                target[key] = {}
            end
            Merge(target[key], value)
        else
            target[key] = value
        end
    end
end

local function NormalizeMedia(value)
    if type(value) ~= "table" then
        return
    end

    for key, child in pairs(value) do
        if type(child) == "table" then
            NormalizeMedia(child)
        elseif type(child) == "string" then
            if child == "Interface\\Addons\\MikScrollingBattleText\\Fonts\\Rurutia.ttf"
                or child == RURUTIA_FONT_PATH then
                value[key] = "Rurutia"
            elseif child == "OUTLINE" then
                -- ElvUI 6.09 renders the modern profile's one-pixel outline
                -- too lightly. Preserve the intended bold outlined look on
                -- build 30300 with its supported thick-outline flag.
                value[key] = "THICKOUTLINE"
            end
        end
    end
end

local function SanitizeDetails(value)
    if type(value) ~= "table" then
        return
    end

    for key, child in pairs(value) do
        if key == "show_timer" and type(child) == "boolean" then
            value[key] = { child, child, child }
        elseif type(child) == "table" then
            SanitizeDetails(child)
        end
    end
end

local function SanitizeElvTags(value)
    if type(value) ~= "table" then
        return
    end

    for key, child in pairs(value) do
        if key == "text_format" and type(child) == "string" then
            child = string.gsub(child, "%[classcolor%](%[power:)", "[powercolor]%1")
            child = string.gsub(child, "%[classcolor%]", "[namecolor]")
            child = string.gsub(child, "%[health:current:shortvalue%]", "[health:current]")
            value[key] = child
        elseif type(child) == "table" then
            SanitizeElvTags(child)
        end
    end
end

-- The source profile was exported from the modern Titan client. ElvUI 6.09
-- has no stable bar 8, so materialize its exact intended position and sizing
-- on legacy bar 6 before the profile is committed. Doing this in the importer
-- avoids a second ElvUI:UpdateAll during the initial world handshake.
local function ApplyTitanCompatibilityProfile(profile)
    profile.movers = profile.movers or {}
    profile.movers.ElvAB_6 =
        "BOTTOM,ElvUIParent,BOTTOM,296,1"

    profile.actionbar = profile.actionbar or {}
    local bar = profile.actionbar.bar6 or {}
    profile.actionbar.bar6 = bar
    bar.enabled = true
    bar.buttons = 12
    bar.buttonsPerRow = 4
    bar.buttonSize = 35
    bar.buttonSpacing = 1
    bar.backdropSpacing = 4
    bar.showGrid = false
    bar.point = "TOPLEFT"
    bar.macrotext = true
    bar.macroFontSize = 14
    bar.macroFontOutline = "THICKOUTLINE"
    bar.macroTextPosition = "BOTTOM"
    bar.macroTextYOffset = 2
    bar.hotkeyFontSize = 14
    bar.hotkeyFontOutline = "THICKOUTLINE"
    bar.hotkeyTextYOffset = -1

    -- ElvUI 6.09 only consumes the legacy raid/raid40 keys.  The source
    -- Titan profile uses raid2 for 25-player content and raid3 for 40-player
    -- content, so map them before the profile is committed.
    local units = profile.unitframe and profile.unitframe.units
    if type(units) == "table" then
        if type(units.raid2) == "table" then
            local raid = DeepCopy(units.raid2)
            raid.enable = true
            raid.numGroups = 5
            raid.groupBy = "INDEX"
            raid.width = 85
            raid.height = 50
            raid.growthDirection = "DOWN_RIGHT"
            raid.visibility = "[@raid1,noexists][@raid41,exists] hide;show"
            units.raid = raid
        end
        if type(units.raid3) == "table" then
            local raid40 = DeepCopy(units.raid3)
            raid40.enable = false
            raid40.numGroups = 8
            units.raid40 = raid40
        end
        units.raid1 = nil
        units.raid2 = nil
        units.raid3 = nil
    end

    profile.movers.ElvUF_RaidMover =
        profile.movers.ElvUF_Raid2Mover
        or "BOTTOMRIGHT,UIParent,BOTTOMRIGHT,-158,379"
    profile.movers.ElvUF_Raid40Mover =
        profile.movers.ElvUF_Raid3Mover
        or "BOTTOMRIGHT,UIParent,BOTTOMRIGHT,-222,353"
    profile.movers.ElvUF_Raid1Mover = nil
    profile.movers.ElvUF_Raid2Mover = nil
    profile.movers.ElvUF_Raid3Mover = nil
end

local function InstallLegacyIndexSort(E)
