local function SetArrow(kind)
    arrow:Show()
    if kind == "left" then
        arrow:SetTexCoord(1, 0, 0, 1)
    elseif kind == "hold" then
        arrow:Hide()
    else
        arrow:SetTexCoord(0, 1, 0, 1)
    end
end

local function RoleData()
    if not activeBoss then return nil end
    activeRole = PlayerRaidRole() or activeRole or "main"
    return activeBoss.roles[activeRole] or activeBoss.roles.main
end

local function Redraw()
    if not DB.enabled or not activeBoss then hud:Hide(); return end
    activeRole = PlayerRaidRole() or activeRole
    if DB.onlyTank and not activeRole then hud:Hide(); return end
    activeRole = activeRole or "main"
    local data = RoleData()
    icon:SetTexture(activeBoss.icon)
    roleText:SetText(activeBoss.name .. " · " .. data[1] .. " · 评分 " .. encounterScore)
    if transient and GetTime() < transientUntil then
        actionText:SetText(transient.title)
        detailText:SetText(transient.detail)
        if transient.severity == 3 then
            actionText:SetTextColor(1, 0.20, 0.16)
            hud:SetBackdropBorderColor(1, 0.18, 0.10, 1)
        else
            actionText:SetTextColor(1, 0.72, 0.20)
            hud:SetBackdropBorderColor(1, 0.58, 0.12, 0.95)
        end
        SetArrow(transient.arrow or "move")
    else
        transient = nil
        actionText:SetText(data[2])
        detailText:SetText(data[3])
        actionText:SetTextColor(0.92, 0.95, 1)
        hud:SetBackdropBorderColor(0.94, 0.61, 0.16, 0.9)
        SetArrow("hold")
    end
    hud:Show()
end

local function Coach(title, detail, severity, duration, penalty, arrowKind)
    transient = {title=title, detail=detail, severity=severity or 2, arrow=arrowKind}
    transientUntil = GetTime() + (duration or 6)
    if penalty and penalty > 0 then
        encounterScore = math.max(0, encounterScore - penalty)
        errorCount = errorCount + 1
    end
    if DB.sound and (severity or 2) >= 3 then PlaySoundFile("Sound\\Interface\\RaidWarning.wav") end
    Redraw()
end

local function ScanBossUnit()
    local units = {"target", "focus", "targettarget", "focustarget"}
    if GetNumRaidMembers and GetNumRaidMembers() > 0 then
        for i = 1, GetNumRaidMembers() do table.insert(units, "raid" .. i .. "target") end
    elseif GetNumPartyMembers then
        for i = 1, GetNumPartyMembers() do table.insert(units, "party" .. i .. "target") end
    end
    for _, unit in ipairs(units) do
        if UnitExists(unit) then
            local entry = CreatureID(UnitGUID(unit))
            if entry and BOSS[entry] then return unit, entry end
        end
    end
end

local function UpdateThreat()
    if not activeBoss then return end
    local unit = ScanBossUnit()
    if not unit then
        threatBar:SetValue(0); threatText:SetText("仇恨：等待首领目标")
        return
    end
    local isTanking, status, scaledPercent, rawPercent, threatValue
    if UnitDetailedThreatSituation then
        isTanking, status, scaledPercent, rawPercent, threatValue = UnitDetailedThreatSituation("player", unit)
    end
    local percent = rawPercent or scaledPercent or 0
    lastThreatPercent = percent
    threatBar:SetValue(math.min(130, percent))
    if isTanking then
        threatBar:SetStatusBarColor(0.22, 0.78, 0.36)
        threatText:SetText(string.format("仇恨：主目标 %.0f%% · 已接稳", percent))
    elseif percent >= 90 then
        threatBar:SetStatusBarColor(1, 0.24, 0.14)
        threatText:SetText(string.format("仇恨：%.0f%% · 即将 OT", percent))
    elseif activeRole == "off" and percent < 70 then
        threatBar:SetStatusBarColor(1, 0.63, 0.18)
        threatText:SetText(string.format("仇恨：%.0f%% · 接班储备不足", percent))
    else
        threatBar:SetStatusBarColor(0.28, 0.62, 0.92)
        threatText:SetText(string.format("仇恨：%.0f%% · 待命", percent))
    end
    local bossTarget = UnitName(unit .. "target")
    if bossTarget and lastBossTarget and bossTarget ~= lastBossTarget and UnitAffectingCombat("player") then
        if bossTarget == UnitName("player") and activeRole ~= "main" then
            Coach("你已接到首领", "定住朝向，确认仇恨变红；不要边嘲讽边横移。", 3, 5, 0, "hold")
        elseif lastBossTarget == UnitName("player") and activeRole == "main" then
            Coach("首领已离开你", "检查是否为计划换坦；若不是，立即嘲讽并恢复原朝向。", 3, 5, 5, "hold")
        end
    end
    lastBossTarget = bossTarget
end

local function Activate(entry)
    local data = BOSS[entry]
    if not data then return end
    if activeBoss ~= data then
        activeBoss, activeEntry = data, entry
        activeRole = PlayerRaidRole() or (DB.role ~= "auto" and DB.role) or "main"
        transient = nil; encounterScore = 100; errorCount = 0; lastBossTarget = nil
        Coach("进入坦克训练", (RoleData() or data.roles.main)[2], 2, 8, 0, "hold")
    end
end

function KajigeSunwellTankCoach_ActivateBoss(entry) Activate(entry) end
function KajigeSunwellTankCoach_Reset()
    if activeBoss and errorCount > 0 then
        Print(activeBoss.name .. " 坦克复盘：评分 " .. encounterScore .. "，记录 " .. errorCount .. " 次关键失误。")
    end
    activeBoss=nil; activeEntry=nil; transient=nil; lastBossTarget=nil; hud:Hide()
end

