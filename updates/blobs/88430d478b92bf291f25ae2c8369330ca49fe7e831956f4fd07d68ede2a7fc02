local function CreatureID(guid)
    if type(guid) ~= "string" or string.sub(guid, 1, 4) ~= "0xF1" then return nil end
    return tonumber(string.sub(guid, 7, 12), 16)
end

local function Print(message)
    DEFAULT_CHAT_FRAME:AddMessage("|cffffb43b[坦克教练]|r " .. message)
end

local function PlayerRaidRole()
    if DB.role ~= "auto" then return DB.role end
    if UnitGroupRolesAssigned then
        local role = UnitGroupRolesAssigned("player")
        if role == "TANK" then return "main" end
    end
    if GetNumRaidMembers and GetNumRaidMembers() > 0 then
        for i = 1, GetNumRaidMembers() do
            local name, rank, subgroup, level, class, fileName, zone, online, dead, raidRole, isML = GetRaidRosterInfo(i)
            if name == UnitName("player") and raidRole == "MAINTANK" then return "main" end
        end
    end
    local _, class = UnitClass("player")
    if class == "WARRIOR" or class == "PALADIN" or class == "DEATHKNIGHT" or class == "DRUID" then
        return "main"
    end
    return nil
end

