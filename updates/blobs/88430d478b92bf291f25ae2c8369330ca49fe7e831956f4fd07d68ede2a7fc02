local frame = CreateFrame("Frame")
for _, event in ipairs({"PLAYER_TARGET_CHANGED","PLAYER_FOCUS_CHANGED","PLAYER_REGEN_DISABLED","PLAYER_REGEN_ENABLED","COMBAT_LOG_EVENT_UNFILTERED","UNIT_THREAT_SITUATION_UPDATE","UNIT_TARGET","RAID_ROSTER_UPDATE","PARTY_MEMBERS_CHANGED"}) do
    frame:RegisterEvent(event)
end
frame:SetScript("OnEvent", function(_, event, ...)
    if event == "PLAYER_REGEN_ENABLED" then
        KajigeSunwellTankCoach_Reset(); return
    end
    if event == "PLAYER_TARGET_CHANGED" or event == "PLAYER_FOCUS_CHANGED" or event == "PLAYER_REGEN_DISABLED" then
        local _, entry = ScanBossUnit(); if entry then Activate(entry) end
        Redraw(); UpdateThreat(); return
    end
    if event == "COMBAT_LOG_EVENT_UNFILTERED" then
        local _, subEvent, sourceGUID, sourceName, sourceFlags, destGUID, destName, destFlags, spellID = ...
        local sourceEntry, destEntry = CreatureID(sourceGUID), CreatureID(destGUID)
        if sourceEntry and BOSS[sourceEntry] then Activate(sourceEntry)
        elseif destEntry and BOSS[destEntry] then Activate(destEntry) end
        if not activeBoss or not spellID then return end
        local item = SPELL[spellID]
        if item then Coach(item[1], item[2], item[3], 6, item[4], item[5]) end
        if subEvent == "SPELL_AURA_APPLIED_DOSE" and spellID == 45150 and destName == UnitName("player") then
            local amount = select(13, ...)
            if amount and amount >= 4 then Coach("流星层数 " .. amount, "检查本组分摊人数；层数过高时报告团长，不要移动首领。", 3, 6, 3, "hold") end
        end
        return
    end
    UpdateThreat(); Redraw()
end)

frame:SetScript("OnUpdate", function(_, elapsed)
    updateElapsed = updateElapsed + elapsed
    if updateElapsed < 0.35 then return end
    updateElapsed = 0
    if transient and GetTime() >= transientUntil then transient = nil; Redraw() end
    if activeBoss then UpdateThreat() end
end)

SLASH_KAJIGESWTANK1 = "/swtank"
SlashCmdList.KAJIGESWTANK = function(message)
    local cmd, arg = string.match(string.lower(message or ""), "^(%S*)%s*(.-)$")
    if cmd == "main" or cmd == "off" or cmd == "add" or cmd == "auto" then
        DB.role = cmd; activeRole = PlayerRaidRole() or (cmd ~= "auto" and cmd); Redraw()
        Print("职责已设为 " .. cmd .. "。")
    elseif cmd == "lock" then DB.locked = true; Print("提示框已锁定。")
    elseif cmd == "unlock" then DB.locked = false; Print("提示框可拖动。")
    elseif cmd == "on" then DB.enabled = true; Redraw()
    elseif cmd == "off" then DB.enabled = false; hud:Hide()
    elseif cmd == "all" then DB.onlyTank = false; Print("所有职业均显示坦克提示。")
    elseif cmd == "tank" then DB.onlyTank = true; Print("仅坦克职责显示提示。")
    elseif cmd == "test" then Activate(tonumber(arg) or 24882); Coach("测试：立即换坦", "副坦原地嘲讽，主坦停止抢仇恨并保持分摊站位。", 3, 8, 0, "hold")
    else
        if guide:IsShown() then guide:Hide() else guide:Show() end
        Print("命令：/swtank main|off|add|auto，lock|unlock，on|off，all|tank，test [首领ID]")
    end
end

hud:Hide()
