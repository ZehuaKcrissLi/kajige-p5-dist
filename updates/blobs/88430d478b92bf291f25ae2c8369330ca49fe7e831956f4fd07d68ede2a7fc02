        table.insert(lines, "  站位：" .. item[2])
        table.insert(lines, "  操作：" .. item[3])
        table.insert(lines, "")
    end
    table.insert(lines, "|cffffd37a团长验收点|r")
    for i, item in ipairs(data.guide) do table.insert(lines, "  " .. i .. ". " .. item) end
    guideText:SetText(table.concat(lines, "\n"))
