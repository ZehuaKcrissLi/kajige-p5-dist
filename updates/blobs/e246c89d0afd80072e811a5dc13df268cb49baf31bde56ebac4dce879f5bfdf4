local function FindMacro(name)
    local accountCount, characterCount = GetNumMacros()
    local index
    for i = 1, (accountCount or 0) do
        if GetMacroInfo(i) == name then
            index = i
            break
        end
    end
    if not index then
        local firstCharacterMacro = (_G.MAX_ACCOUNT_MACROS or 36) + 1
        local lastCharacterMacro =
            firstCharacterMacro + (characterCount or 0) - 1
        for i = firstCharacterMacro, lastCharacterMacro do
            if GetMacroInfo(i) == name then
                index = i
                break
            end
        end
    end
    return index
end

local function InstallMacros()
    DB.macroErrors = {}
    -- 2026.07.29 以前的兼容模板使用过这两个非时光服宏名。先删除，
    -- 避免占满 3.3.5 的 18 个角色宏槽并让动作条继续引用旧版本。
    for _, legacyName in ipairs({
        "混沌流星", "混乱之雨",
        "露露AOE", "露露分流", "露露暗影箭", "露露暗灼",
        "露露法阵", "露露混乱箭", "露露烧尽", "露露燃烧",
        "露露献祭", "露露碎裂", "露露腐蚀", "露露诅咒",
    }) do
        local legacyIndex = FindMacro(legacyName)
        if legacyIndex then DeleteMacro(legacyIndex) end
    end
    for _, template in ipairs(macroTemplates) do
        local body = template.body()
        local index = FindMacro(template.name)
        if not index and template.name == "群体种子" then
            index = FindMacro("AOE种子")
        end
        if index then
            local edited, editResult = pcall(
                EditMacro,
                index,
                template.name,
                template.icon,
                body
            )
            if not edited then
                DB.lastMacroError = tostring(editResult)
                index = nil
            end
        else
            local perCharacter
            if template.perCharacter ~= false then perCharacter = 1 end
            local created, createResult = pcall(
                CreateMacro,
                template.name,
                template.icon,
                body,
                perCharacter
            )
            if created then
                index = createResult
            else
                DB.lastMacroError = tostring(createResult)
                index = nil
            end
        end
        if not index then
            table.insert(DB.macroErrors, template.name)
        end
    end
end

local function SpellBookSlot(spellID)
    local expected = GetSpellInfo(spellID)
    if not expected then return nil end
    local tabs = GetNumSpellTabs and GetNumSpellTabs() or 0
    for tab = 1, tabs do
        local _, _, offset, count = GetSpellTabInfo(tab)
        for index = offset + 1, offset + count do
            local name = GetSpellName(index, BOOKTYPE_SPELL)
            if name == expected then return index end
        end
    end
end

local function KnowsSpell(spellID)
    if IsSpellKnown and IsSpellKnown(spellID) then return true end
    return SpellBookSlot(spellID) ~= nil
end

