local function AuditIdentity()
    local localizedClass, class = UnitClass("player")
    local localizedRace, race = UnitRace("player")
    DB.identity = {
        name = UnitName("player"),
        realm = GetRealmName(),
        level = UnitLevel("player"),
        class = class,
        localizedClass = localizedClasses[class] or localizedClass,
        race = race,
        localizedRace = localizedRaces[race] or localizedRace,
        sex = UnitSex("player"),
        auditedAt = date("%Y-%m-%d %H:%M:%S"),
    }
end

local function AuditSpells()
    DB.missingSpells = {}
    DB.compatibilitySpells = {}
    DB.serverProvisionedSpells = {}
    for _, spellID in ipairs(requiredSpells) do
        if serverProvisionedSpells[spellID] then
            table.insert(DB.serverProvisionedSpells, spellID)
        elseif GetSpellInfo(spellID) and not KnowsSpell(spellID) then
            table.insert(DB.missingSpells, spellID)
        end
    end
    for _, spellID in ipairs({1295198, 1295358}) do
        if not GetSpellInfo(spellID) then
            local fallback = spellID == 1295198 and 47820 or 47847
            table.insert(DB.compatibilitySpells, {
                titanSpell = spellID,
                fallbackSpell = fallback,
                fallbackName = compatibilityNames[fallback]
                    or GetSpellInfo(fallback),
            })
        end
    end
    DB.compatibilityNotes = {
        "3.3.5 不支持现代客户端的 @cursor 条件，地面技能保留点击落点。",
        "混沌流星在旧内核中以暗影之怒代替；混乱之雨以火焰之雨代替。",
        "现代时光服 SavedVariables 不直接覆盖旧客户端，由兼容插件逐项转换。",
        "ELVUIBAR8 在旧版 ElvUI 中对应可用的 ELVUIBAR6。",
    }
end

