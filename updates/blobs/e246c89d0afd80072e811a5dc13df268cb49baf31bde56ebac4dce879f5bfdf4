    end
end

frame:RegisterEvent("ADDON_LOADED")
frame:RegisterEvent("PLAYER_LOGIN")
frame:SetScript("OnEvent", function(self, event, addonName)
    if event == "ADDON_LOADED" then
        if addonName ~= "!KajigeLeaderExperience" then return end
        InitializeDB()
        self:UnregisterEvent("ADDON_LOADED")
        return
    end
    if not DB then InitializeDB() end
    if not IsLeader() or applyPending then return end
    AuditIdentity()
    if DB.appliedVersion ~= ADDON_VERSION then
        local delayed = CreateFrame("Frame")
        local elapsed = 0
        delayed:SetScript("OnUpdate", function(self, delta)
            elapsed = elapsed + delta
            if elapsed < 5 then return end
            self:SetScript("OnUpdate", nil)
            -- The base profile importer owns first-run layout installation.
            -- Rewriting macros/actions/bindings from a second add-on five
            -- seconds into build 12340's world handshake makes the client send
            -- CMSG_LOGOUT_REQUEST and loop back to character selection. Keep
            -- this add-on's automatic path read-only; explicit
            -- /kjgprofile apply remains available for deliberate repairs.
            AuditSpells()
            DB.appliedVersion = ADDON_VERSION
            DB.appliedAt = date("%Y-%m-%d %H:%M:%S")
            DEFAULT_CHAT_FRAME:AddMessage(
                "|cff00ff96咔鸡哥：|r团长模板已审计，统一布局由首次配置导入器维护。"
            )
        end)
    else
        AuditSpells()
    end
end)
