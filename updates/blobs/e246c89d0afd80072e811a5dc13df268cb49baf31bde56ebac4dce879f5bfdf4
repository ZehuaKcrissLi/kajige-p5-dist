local function PutAction(slot, action)
    ClearCursor()
    if action[1] == "macro" then
        local index = FindMacro(action[2])
        if not index then return false, "缺少宏：" .. action[2] end
        PickupMacro(index)
    elseif action[1] == "spell" then
        local index = SpellBookSlot(action[2])
        if not index then return false, "缺少技能：" .. tostring(action[2]) end
        PickupSpell(index, BOOKTYPE_SPELL)
    elseif action[1] == "item" then
        if GetItemCount(action[2], true) == 0 then
            return false, "缺少物品：" .. tostring(action[2])
        end
        PickupItem(action[2])
    end
    local cursorType = GetCursorInfo()
    if cursorType then
        _G.PlaceAction(slot)
        ClearCursor()
        return true
    end
    return false, "无法拾取动作：" .. tostring(slot)
end

local function InstallActions()
    DB.actionErrors = {}
    for slot, action in pairs(actionTemplate) do
        local ok, reason = PutAction(slot, action)
        if not ok then table.insert(DB.actionErrors, reason) end
    end
end

