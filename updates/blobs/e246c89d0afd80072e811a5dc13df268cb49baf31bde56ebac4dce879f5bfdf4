    InstallMacros()
    InstallActions()
    InstallBindings()
    InstallCVars()
    AuditIdentity()
    AuditSpells()
    DB.appliedVersion = ADDON_VERSION
    DB.appliedAt = date("%Y-%m-%d %H:%M:%S")
    DEFAULT_CHAT_FRAME:AddMessage("|cff00ff96咔鸡哥：|r团长术士体验模板已同步；缺失项已写入审计记录。")
end

local function QueueMissingSpells()
    AuditSpells()
    commandQueue = {}
    for _, spellID in ipairs(DB.missingSpells) do
        table.insert(commandQueue, ".learn " .. tostring(spellID))
    end
    if #commandQueue == 0 then
        FinishInstall()
        return
    end
    applyPending = true
    frame:SetScript("OnUpdate", function(self, elapsed)
        commandElapsed = commandElapsed + elapsed
        if commandElapsed < 0.65 then return end
        commandElapsed = 0
        local command = table.remove(commandQueue, 1)
        if command then
            SendChatMessage(command, "SAY")
            return
        end
        self:SetScript("OnUpdate", nil)
        applyPending = false
        local finish = CreateFrame("Frame")
        local wait = 0
        finish:SetScript("OnUpdate", function(delayed, delta)
            wait = wait + delta
            if wait < 2 then return end
            delayed:SetScript("OnUpdate", nil)
            FinishInstall()
        end)
    end)
end

