        LocalizeSystemMessage
    )
end

local tooltipNames = {
    "GameTooltip",
    "ItemRefTooltip",
    "ShoppingTooltip1",
    "ShoppingTooltip2",
    "ItemRefShoppingTooltip1",
    "ItemRefShoppingTooltip2",
}

local function ScanTooltip(tooltip)
    if not tooltip or not tooltip.GetName or not tooltip.NumLines then return end
    local name = tooltip:GetName()
    if not name then return end
    for lineIndex = 1, tooltip:NumLines() do
        for _, side in ipairs({ "TextLeft", "TextRight" }) do
            local line = getglobal(name .. side .. lineIndex)
            if line and line.GetText and line.SetText then
                local text = line:GetText()
                local translated = TranslateLine(text)
                if translated and translated ~= text then
                    line:SetText(translated)
                end
            end
        end
    end
end

for _, tooltipName in ipairs(tooltipNames) do
    local tooltip = getglobal(tooltipName)
    if tooltip and tooltip.HookScript then
        tooltip:HookScript("OnTooltipSetItem", ScanTooltip)
        tooltip:HookScript("OnTooltipSetUnit", ScanTooltip)
        tooltip:HookScript("OnTooltipSetSpell", ScanTooltip)
        tooltip:HookScript("OnShow", ScanTooltip)
    end
end

-- ElvUI/EpochCN may draw the target summary (for example "5 Humanoid" and
-- "ID 1568") in unnamed frames and may refresh those FontStrings after the
-- standard GameTooltip callbacks have returned.  Run a short, event-batched
-- sweep after the target or mouseover unit changes.  Three passes cover the
-- deferred refreshes without repeatedly walking every visible frame while a
-- tooltip remains open.
local visibleEnglishSweep = CreateFrame("Frame")
local sweepPassesRemaining = 0
local sweepElapsed = 0

local function ScanVisibleFunctionalEnglish()
    if type(EnumerateFrames) ~= "function" then return end
    local frame = EnumerateFrames()
    while frame do
        if frame.IsVisible and frame:IsVisible() and frame.GetRegions then
            local regions = { frame:GetRegions() }
            for _, region in ipairs(regions) do
                if region
                    and region.GetObjectType
                    and region:GetObjectType() == "FontString"
                    and region.GetText
                    and region.SetText then
                    local text = region:GetText()
                    local translated = TranslateLine(text)
                    if translated and translated ~= text then
                        region:SetText(translated)
                    end
                end
            end
        end
        frame = EnumerateFrames(frame)
    end
end

local function ScheduleVisibleEnglishSweep()
    sweepPassesRemaining = 3
    sweepElapsed = 0.1
    visibleEnglishSweep:Show()
end

visibleEnglishSweep:RegisterEvent("PLAYER_ENTERING_WORLD")
visibleEnglishSweep:RegisterEvent("PLAYER_TARGET_CHANGED")
visibleEnglishSweep:RegisterEvent("UPDATE_MOUSEOVER_UNIT")
visibleEnglishSweep:RegisterEvent("UPDATE_WORLD_STATES")
visibleEnglishSweep:RegisterEvent("ZONE_CHANGED")
visibleEnglishSweep:RegisterEvent("ZONE_CHANGED_INDOORS")
visibleEnglishSweep:RegisterEvent("ZONE_CHANGED_NEW_AREA")
visibleEnglishSweep:RegisterEvent("GOSSIP_SHOW")
visibleEnglishSweep:SetScript("OnEvent", ScheduleVisibleEnglishSweep)
visibleEnglishSweep:SetScript("OnUpdate", function(self, elapsed)
    if sweepPassesRemaining <= 0 then
        self:Hide()
        return
    end
    sweepElapsed = sweepElapsed + elapsed
    if sweepElapsed < 0.1 then return end
    sweepElapsed = 0
    sweepPassesRemaining = sweepPassesRemaining - 1
    ScanVisibleFunctionalEnglish()
end)
visibleEnglishSweep:Hide()

-- Static popups are created after the login/zone sweeps.  Localize their
-- standard functional text at the popup's existing OnShow boundary instead
-- of polling the full UI.
local function LocalizeStaticPopup(frame)
    if not frame or not frame.GetName then return end
    local name = frame:GetName()
    local textRegion = name and getglobal(name .. "Text")
    if textRegion and textRegion.GetText and textRegion.SetText then
        local text = textRegion:GetText()
        local translated = TranslateLine(text)
        if translated and translated ~= text then
            textRegion:SetText(translated)
        end
    end
    for index = 1, 4 do
        local button = name and getglobal(name .. "Button" .. index)
        if button and button.GetText and button.SetText then
            local text = button:GetText()
            local translated = TranslateLine(text)
            if translated and translated ~= text then
                button:SetText(translated)
            end
        end
    end
end

for index = 1, 4 do
    local popup = getglobal("StaticPopup" .. index)
    if popup and popup.HookScript then
        popup:HookScript("OnShow", LocalizeStaticPopup)
    end
end
