-- ElvUI 6.09 ships a complete 3.3.5 zhCN locale, but selects enUS because
-- the binary itself is enUS.  AceLocale has already loaded every locale by
-- the time this dependent overlay runs.  Merge the bundled zhCN table into
-- the active table in place so every ElvUI module that captured `L` receives
-- Chinese text without polling or scanning the UI every frame.
local function LocalizeElvUI()
    if type(ElvUI) ~= "table" then return end
    local engine, activeLocale = unpack(ElvUI)
    local localeLibrary = engine and engine.Libs and engine.Libs.ACL
    local chineseLocale = localeLibrary
        and localeLibrary:GetLocale("ElvUI", "zhCN", true)

    if type(activeLocale) == "table" and type(chineseLocale) == "table" then
        for key, localized in pairs(chineseLocale) do
            if type(localized) == "string" and localized ~= "" then
                activeLocale[key] = localized
            end
        end
    end

    -- RaidUtility reads this global when its frame is initialized.
    RAID_CONTROL = "团队管理"

    -- The legacy durability data text captured the enUS global as a local
    -- while its file loaded.  Translate its output at the existing inventory
    -- event boundary; this adds no per-frame work.
    local dataTexts = engine and engine.GetModule
        and engine:GetModule("DataTexts")
    local durability = dataTexts
        and dataTexts.RegisteredDataTexts
        and dataTexts.RegisteredDataTexts["Durability"]
    if durability and type(durability.eventFunc) == "function" then
        local originalDurabilityEvent = durability.eventFunc
        durability.eventFunc = function(self, ...)
            originalDurabilityEvent(self, ...)
            local text = self and self.text and self.text:GetText()
            if type(text) == "string" then
                self.text:SetText(
                    string.gsub(text, "^Durability:", "耐久度：")
                )
            end
        end
        durability.localizedName = "耐久度"
    end
end

if IsAddOnLoaded and IsAddOnLoaded("ElvUI") then
    LocalizeElvUI()
else
    local elvLocaleFrame = CreateFrame("Frame")
    elvLocaleFrame:RegisterEvent("ADDON_LOADED")
    elvLocaleFrame:SetScript("OnEvent", function(self, event, addonName)
        if addonName == "ElvUI" then
            LocalizeElvUI()
            self:UnregisterEvent("ADDON_LOADED")
        end
    end)
end

