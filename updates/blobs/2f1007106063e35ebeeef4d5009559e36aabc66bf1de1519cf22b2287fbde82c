local function TranslateRaceClass(text)
    if type(text) ~= "string" then return end
    local level, descriptor = string.match(text, "^(%d+)%s+(.+)$")
    if not descriptor then descriptor = text end
    for _, race in ipairs(orderedRaceNames) do
        local class = string.match(descriptor, "^" .. race .. "%s+(.+)$")
        if class and classNames[class] then
            local prefix = level and (level .. "级 ") or ""
            return prefix .. raceNames[race] .. " " .. classNames[class]
        end
    end
end

-- EpochCN 0.7.4 stores a Chinese display title in E.name, while WoW's
-- ADDON_LOADED event reports the folder name "EpochCN".  That prevents the
-- upstream event handler from ever calling Initialize() on this client.
-- Loading EpochCN as a required dependency lets this small overlay repair the
-- bootstrap without modifying the 37 MB third-party add-on in place.
if EpochCN and EpochCN.Initialize and not EpochCN.KajigeInitialized then
    EpochCN.KajigeInitialized = true
    EpochCN:Initialize()
end

-- EpochCN normally keeps FrameXML translations in a display-layer map.
-- Apply entries with identical printf signatures to the actual globals before
-- later add-ons load, so their file-local captures (DURABILITY, slot names,
-- backpack labels, and similar constants) are Chinese from the start.
local function FormatSignature(text)
    if type(text) ~= "string" then return "" end
    local signature = ""
    local position = 1
    while true do
        local startAt, endAt, specifier = string.find(
            text,
            "%%[%-%+ #0-9%.]*([cdeEfgGiouqsxX%%])",
            position
        )
        if not startAt then break end
        if specifier ~= "%" then signature = signature .. specifier end
        position = endAt + 1
    end
    return signature
end

for key, localized in pairs(EpochCN_FrameXMLStrings or {}) do
    local original = getglobal(key)
    if type(original) == "string"
        and type(localized) == "string"
        and FormatSignature(original) == FormatSignature(localized) then
        setglobal(key, localized)
    end
end
