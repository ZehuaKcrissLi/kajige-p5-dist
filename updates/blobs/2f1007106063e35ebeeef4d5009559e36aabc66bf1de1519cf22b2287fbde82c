-- O(1)，不需要按帧遍历 UI。
local dynamicMapFontStringNames = {
    "ZoneTextString",
    "SubZoneTextString",
    "MinimapZoneText",
    "WorldMapFrameAreaLabel",
    "WorldMapContinentDropDownText",
    "WorldMapZoneDropDownText",
