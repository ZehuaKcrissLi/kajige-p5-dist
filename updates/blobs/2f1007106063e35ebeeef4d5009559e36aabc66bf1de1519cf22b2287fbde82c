    ChatFrame1TabText = "综合",
    ChatFrame2TabText = "战斗记录",
}

local function LocalizeMapFontString(fontString, text)
    if not fontString or fontString.KajigeSettingMapText then return end
    if type(text) ~= "string" or text == "" then return end
    local translated = EpochCN_Overrides
        and EpochCN_Overrides.maps
        and EpochCN_Overrides.maps[Trim(text)]
    if not translated or translated == text then return end
    fontString.KajigeSettingMapText = true
    fontString:SetText(translated)
    fontString.KajigeSettingMapText = false
end

local function LocalizeFixedFunctionalFontString(fontString, text)
    if not fontString or fontString.KajigeSettingFunctionalText then return end
    if type(text) ~= "string" or text == "" then return end
    local name = fontString.GetName and fontString:GetName()
    local translated = name and fixedFunctionalFontStrings[name]
    if not translated and text == "Combat Log" then
        translated = "战斗记录"
    end
    if not translated or translated == text then return end
    fontString.KajigeSettingFunctionalText = true
    fontString:SetText(translated)
    fontString.KajigeSettingFunctionalText = false
end

local function HookDynamicMapFontStrings()
    for _, name in ipairs(dynamicMapFontStringNames) do
        local fontString = getglobal(name)
        if fontString and fontString.GetText and fontString.SetText then
            if not fontString.KajigeMapTextHooked and hooksecurefunc then
                fontString.KajigeMapTextHooked = true
                pcall(hooksecurefunc, fontString, "SetText", function(self, text)
                    LocalizeMapFontString(self, text)
                end)
            end
            LocalizeMapFontString(fontString, fontString:GetText())
        end
    end
    for name in pairs(fixedFunctionalFontStrings) do
        local fontString = getglobal(name)
        if fontString and fontString.GetText and fontString.SetText then
            if not fontString.KajigeFunctionalTextHooked and hooksecurefunc then
                fontString.KajigeFunctionalTextHooked = true
                pcall(hooksecurefunc, fontString, "SetText", function(self, text)
                    LocalizeFixedFunctionalFontString(self, text)
                end)
            end
            LocalizeFixedFunctionalFontString(fontString, fontString:GetText())
        end
    end
end

