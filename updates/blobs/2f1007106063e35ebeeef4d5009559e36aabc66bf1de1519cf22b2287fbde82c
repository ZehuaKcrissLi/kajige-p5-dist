local function Trim(text)
    if type(text) ~= "string" then return text end
    text = string.gsub(text, "^%s+", "")
    text = string.gsub(text, "%s+$", "")
    return text
end

local function TranslateEffect(text)
    if exactEffects[text] then return exactEffects[text] end

    local amount = string.match(text, "^Restores (%d+) mana per 5 sec")
        or string.match(text, "^Restores (%d+) mana every 5 sec")
        or string.match(text, "^Restores (%d+) mana per 5 seconds")
        or string.match(text, "^Restores (%d+) mana every 5 seconds")
    if amount then return "每5秒恢复 " .. amount .. " 点法力值。" end

    amount = string.match(text, "^Restores (%d+) health per 5 sec")
        or string.match(text, "^Restores (%d+) health every 5 sec")
        or string.match(text, "^Restores (%d+) health per 5 seconds")
        or string.match(text, "^Restores (%d+) health every 5 seconds")
    if amount then return "每5秒恢复 " .. amount .. " 点生命值。" end

    local term, value = string.match(text, "^Increases your (.-) by (%d+)%.?$")
    if not term then term, value = string.match(text, "^Increases (.-) by (%d+)%.?$") end
    if not term then term, value = string.match(text, "^Improves your (.-) by (%d+)%.?$") end
    if not term then term, value = string.match(text, "^Improves (.-) by (%d+)%.?$") end
    if term and value then
        local localized = ratingNames[string.lower(term)]
        if localized then return localized .. "提高 " .. value .. " 点。" end
    end

    local percentage
    term, percentage = string.match(text, "^Increases your (.-) by (%d+)%%%.?$")
    if not term then term, percentage = string.match(text, "^Improves your (.-) by (%d+)%%%.?$") end
    if term and percentage then
        local localized = ratingNames[string.lower(term)]
        if localized then return localized .. "提高 " .. percentage .. "%。" end
    end
end

local function TranslateLine(raw)
    if type(raw) ~= "string" or not string.find(raw, "[A-Za-z]") then return end
    local text = Trim(raw)
    local lookupText = string.gsub(text, "|c%x%x%x%x%x%x%x%x", "")
    lookupText = string.gsub(lookupText, "|r", "")
    lookupText = Trim(lookupText)

    if EpochCN and EpochCN.localizedTextByRaw then
        local localized = EpochCN.localizedTextByRaw[lookupText]
        if type(localized) == "string" and localized ~= lookupText then
            return localized
        end
        if EpochCN.NormalizeDisplayText then
            localized = EpochCN.localizedTextByRaw[
                EpochCN:NormalizeDisplayText(lookupText)
            ]
            if type(localized) == "string" and localized ~= lookupText then
                return localized
            end
        end
    end
    if EpochCN_Glossary and EpochCN_Glossary.text
        and EpochCN_Glossary.text[lookupText] then
        return EpochCN_Glossary.text[lookupText]
    end
    if EpochCN_TooltipLineData and EpochCN_TooltipLineData[lookupText] then
        return EpochCN_TooltipLineData[lookupText]
    end
    if exactLines[lookupText] then return exactLines[lookupText] end
    if EpochCN_Overrides and EpochCN_Overrides.maps
        and EpochCN_Overrides.maps[lookupText] then
        return EpochCN_Overrides.maps[lookupText]
    end
    local localizedRaceClass = TranslateRaceClass(lookupText)
    if localizedRaceClass then return localizedRaceClass end

    local unitLevel, unitType = string.match(lookupText, "^(%d+)%s+(.+)$")
    if unitLevel and creatureTypes[unitType] then
        return unitLevel .. "级 " .. creatureTypes[unitType]
    end
    local technicalID = string.match(lookupText, "^ID%s+(%d+)$")
    if technicalID then return "编号 " .. technicalID end

    -- PvP/outdoor objective labels come from enUS WorldStateUI.dbc and are
    -- written into unnamed FontStrings after the normal zone-name callbacks.
    -- Preserve their live counters while translating the functional label.
    for pattern, localized in pairs(worldStatePatterns) do
        local value = string.match(lookupText, pattern)
        if value then return string.format(localized, value) end
    end

    -- Gem/enchant lines often start with an inline texture escape.  Replace
    -- the stat phrase in place so the icon and any color codes are preserved.
    for english, chinese in pairs(statNames) do
        local translated, replacements = string.gsub(
            text,
            "%+(%d+) " .. english,
            "+%1 " .. chinese
        )
        if replacements > 0 then return translated end
    end

    local value, stat = string.match(text, "^%+(%d+) (.+)$")
    if value and statNames[stat] then return "+" .. value .. " " .. statNames[stat] end

    value = string.match(text, "^([%d,]+) Armor$")
    if value then return value .. " 点护甲" end
    value = string.match(text, "^([%d,]+) Block$")
    if value then return value .. " 点格挡" end
    value = string.match(text, "^Speed ([%d%.]+)$")
    if value then return "速度 " .. value end
    value = string.match(text, "^%(([%d%.]+) damage per second%)$")
    if value then return "（每秒伤害 " .. value .. "）" end

    local low, high = string.match(text, "^([%d,]+) %- ([%d,]+) Damage$")
    if low and high then return low .. " - " .. high .. " 点伤害" end
    local school
    low, high, school = string.match(text, "^([%d,]+) %- ([%d,]+) (%a+) Damage$")
    if low and high and school then
        return low .. " - " .. high .. " 点" .. (schoolNames[school] or school) .. "伤害"
    end

    local current, maximum = string.match(text, "^Durability (%d+) / (%d+)$")
    if current and maximum then return "耐久度 " .. current .. " / " .. maximum end
    value = string.match(text, "^Item Level (%d+)$")
    if value then return "物品等级 " .. value end
    value = string.match(text, "^Requires Level (%d+)$")
    if value then return "需要等级 " .. value end

    local bonus = string.match(text, "^Socket Bonus:%s*(.+)$")
    if bonus then
        local translated = TranslateLine(bonus)
        return translated and ("插槽奖励：" .. translated) or nil
    end

    local prefix, effect = string.match(text, "^(Equip):%s*(.+)$")
    if not prefix then prefix, effect = string.match(text, "^(Use):%s*(.+)$") end
    if not prefix then prefix, effect = string.match(text, "^(Chance on hit):%s*(.+)$") end
    if effect then
        local translated = TranslateEffect(effect)
        if translated then
            local localizedPrefix = prefix == "Equip" and "装备："
                or prefix == "Use" and "使用："
                or "击中时可能："
            return localizedPrefix .. translated
        end
    end

    return TranslateEffect(text)
end

