function KajigeItemWorkshop.Toggle()
    if not UI then Build() end
    if UI:IsShown() then UI:Hide(); return end
    UI:Show()
    allowed = false
    busy = false
    UI.status:SetText("等待服务器验证 GM3 权限…")
    SendChatMessage(".kjg permission", "SAY")
end

local staging = nil
local event = CreateFrame("Frame")
event:RegisterEvent("CHAT_MSG_SYSTEM")
event:RegisterEvent("PLAYER_ENTERING_WORLD")
event:SetScript("OnEvent", function(_, name, message)
    if name == "PLAYER_ENTERING_WORLD" then
        allowed, busy = false, false
        if UI then UI:Hide() end
        return
    end
    local security = string.match(message or "", "^KJG_PERMISSION:[A-Z0-9%-]+:(%d+):%d+$")
    if security then
        allowed = tonumber(security) >= 3
        if UI and UI:IsShown() then
            if allowed then
                sentAt = -1
                Query(0)
                Send(".kjworkshop shop list")
                Send(".kjworkshop toy list")
            else
                UI.status:SetText("仅 GM3 可以使用物品工坊。")
            end
        end
        return
    end
    if not UI or not allowed then return end
    local toyCount, learned, summoned = string.match(message or "", "^KJG_WT:(%d+):(%d+):(%d+)$")
    if toyCount then
        UI.toyInfo:SetText("个人货单 · " .. toyCount .. " 件物品\n" ..
            (learned == "1" and "召唤技能已学会" or "召唤技能尚未学习") .. " · " ..
            (summoned == "1" and "商人已召唤" or "商人已收回"))
        return
    end
    local req, current, count, matches = string.match(message or "", "^KJG_WB:(%d+):(%d+):(%d+):(%d+)$")
    if req and tonumber(req) == request then
        staging = {}
        page, pages, total = tonumber(current), tonumber(count), tonumber(matches)
        return
    end
    local rowRequest, id, quality, level, itemName = string.match(message or "", "^KJG_WI:(%d+):(%d+):(%d+):(%d+):(.*)$")
    if rowRequest and tonumber(rowRequest) == request and staging then
        table.insert(staging, {id=tonumber(id), quality=tonumber(quality), level=tonumber(level), name=itemName})
        return
    end
    local ended = string.match(message or "", "^KJG_WE:(%d+)$")
    if ended and tonumber(ended) == request and staging then
        busy = false
        for i, item in ipairs(staging) do
            local row = rows[i]
            if row then
                row.itemID = item.id
                row.label:SetText("|c" .. (colors[item.quality + 1] or "ffffffff") .. item.name .. "|r")
                row.detail:SetText("ID " .. item.id .. " · 物品等级 " .. item.level)
                local _, _, _, _, _, _, _, _, _, icon = GetItemInfo(item.id)
                row.icon:SetTexture(icon or "Interface\\Icons\\INV_Misc_QuestionMark")
                row:Show()
            end
        end
        staging = nil
        UI.status:SetText((stockMode and "当前商人货单" or "物品目录") .. " · " .. total .. " 件结果")
        UI.page:SetText("第 " .. (page + 1) .. " / " .. pages .. " 页")
        return
    end
    local entry, spawn, shopName = string.match(message or "", "^KJG_WC:(%d+):(%d+):(.*)$")
    if entry then
        table.insert(shops, {id=tonumber(entry), count=0, name=shopName})
        shopIndex = #shops
        UpdateShop()
        Send(".kjworkshop shop list")
        return
    end
    if message == "KJG_WL:begin" then
        UI.previousShop = SelectedShop() and SelectedShop().id
        shops = {}; shopIndex = 1
        return
    end
    local shopID, stockCount, label = string.match(message or "", "^KJG_WS:(%d+):(%d+):(.*)$")
    if shopID then
        table.insert(shops, {id=tonumber(shopID), count=tonumber(stockCount), name=label})
        if tonumber(shopID) == UI.previousShop then shopIndex = #shops end
        return
    end
    if message == "KJG_WL:end" then UpdateShop() end
end)

ChatFrame_AddMessageEventFilter("CHAT_MSG_SYSTEM", function(_, _, message)
    return string.find(message or "", "^KJG_W[A-Z]:") ~= nil
end)

