local function Print(message)
    DEFAULT_CHAT_FRAME:AddMessage("|cff00ff96咔鸡物品工坊|r " .. message)
end

local function Send(command)
    if not allowed then
        Print("需要服务器验证的 GM3 权限。")
        return false
    end
    SendChatMessage(command, "SAY")
    return true
end

local function Text(parent, text, x, y, width, font)
    local label = parent:CreateFontString(nil, "OVERLAY", font or "GameFontHighlightSmall")
    label:SetPoint("TOPLEFT", parent, "TOPLEFT", x, y)
    label:SetWidth(width)
    label:SetJustifyH("LEFT")
    label:SetText(text)
    return label
end

local function Button(parent, text, x, y, width, action)
    local button = CreateFrame("Button", nil, parent, "UIPanelButtonTemplate")
    button:SetPoint("TOPLEFT", parent, "TOPLEFT", x, y)
    button:SetSize(width, 25)
    button:SetText(text)
    button:SetScript("OnClick", action)
    return button
end

local function Edit(parent, x, y, width, text, numeric)
    local edit = CreateFrame("EditBox", nil, parent, "InputBoxTemplate")
    edit:SetPoint("TOPLEFT", parent, "TOPLEFT", x, y)
    edit:SetSize(width, 25)
    edit:SetAutoFocus(false)
    edit:EnableMouse(true)
    edit:SetScript("OnMouseDown", function(self) self:SetFocus() end)
    edit:SetMaxLetters(numeric and 10 or 60)
    if numeric then edit:SetNumeric(true) end
    edit:SetText(text or "")
    edit:SetScript("OnEscapePressed", function(self) self:ClearFocus() end)
    return edit
end

local function SelectedShop()
    return shops[shopIndex]
end

local function UpdateShop()
    if not UI then return end
    local shop = SelectedShop()
    if shop then
        UI.shop:SetText(shop.name)
        UI.shopInfo:SetText("商店 ID " .. shop.id .. " · " .. shop.count .. " 件货物\n" .. shopIndex .. " / " .. #shops .. " 个商人（点名称切换）")
    else
        UI.shop:SetText("尚未选择商人")
        UI.shopInfo:SetText("在副本外创建商人，或刷新已有商人。")
    end
end

local function Query(newPage)
    if not UI or not allowed or busy then return end
    if GetTime() - sentAt < 0.35 then return end
    request = request + 1
    page = math.max(0, newPage or 0)
    for _, row in ipairs(rows) do row:Hide() end
    UI.status:SetText("正在查询…")
    local command
    if stockMode then
        if portableMode then
            command = ".kjworkshop toy browse " .. request .. " " .. page
        else
            local shop = SelectedShop()
            if not shop then UI.status:SetText("请先选择一个商人。"); return end
            command = ".kjworkshop shop browse " .. request .. " " .. page .. " " .. shop.id
        end
    else
        local query = UI.search:GetText() or ""
        query = string.gsub(query, "[\r\n|]", " ")
        query = string.gsub(query, "^%s*(.-)%s*$", "%1")
        if #query > 128 then
            UI.status:SetText("搜索文字太长，请缩短后重试。")
            return
        end
        if query == "" then query = "-" end
        command = ".kjworkshop search " .. request .. " " .. page .. " " .. category .. " " .. query
    end
    busy, sentAt = true, GetTime()
    Send(command)
end

local function Count()
    local value = tonumber(UI.quantity:GetText()) or 1
    value = math.floor(math.max(1, math.min(1000, value)))
    UI.quantity:SetText(tostring(value))
    return value
end

local function Grant(id)
    Send(".kjworkshop give " .. id .. " " .. Count())
end

local function StockItem(id, remove)
    if portableMode then
        Send(".kjworkshop toy " .. (remove and "remove " or "add ") .. id)
        Send(".kjworkshop toy list")
        return
    end
    local shop = SelectedShop()
    if not shop then
        Print("先创建或选择一个收藏商人。")
        return
    end
    Send(".kjworkshop shop " .. (remove and "remove " or "add ") .. shop.id .. " " .. id)
end

