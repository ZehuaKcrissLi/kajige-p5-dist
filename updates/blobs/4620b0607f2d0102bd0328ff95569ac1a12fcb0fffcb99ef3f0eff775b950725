    if name then return "你学会了新技能：" .. LocalizeAbilityName(name) .. "。" end
    name = string.match(visible, "^你学会新的法术：(.+)$")
        or string.match(visible, "^你学会新的技能：(.+)$")
    if name then
        return "你学会了新技能：" .. LocalizeAbilityName(name) .. "。"
    end

