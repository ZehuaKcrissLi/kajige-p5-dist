local function ChatFilter(_, event, message, ...)
    message = LocalizeChatLine(message)
    local visible = VisibleText(message)
    if botCommands[visible] then
        return false, botCommands[visible], ...
    end
    if string.find(visible, "^talents spec ") then
        return false, "正在为目标机器人切换 PVE 天赋模板。", ...
    end
    local translated = Translate(message)
    if translated then return false, translated, ... end
    if auditedEvents[event] then Audit(event, message) end
    return false, message, ...
end

local function BelongsToChatFrame(widget)
    local current = widget
    local depth = 0
    while current and depth < 10 do
        if current == DEFAULT_CHAT_FRAME then return true end
        if current.GetObjectType
            and current:GetObjectType() == "ScrollingMessageFrame" then
            return true
        end
        if current.GetName then
            local name = current:GetName()
            if type(name) == "string"
                and string.find(name, "^ChatFrame%d*") then
                return true
            end
        end
        current = current.GetParent and current:GetParent() or nil
        depth = depth + 1
    end
    return false
end

