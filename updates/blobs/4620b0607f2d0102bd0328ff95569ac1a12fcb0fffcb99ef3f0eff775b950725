    if type(message) ~= "string" then return message end
    for _, pattern in ipairs(embeddedSpellPatterns) do
        message = string.gsub(message, pattern, function(prefix, spell, suffix)
            return prefix .. LocalizeAbilityName(spell) .. suffix
        end)
    end
    return message
