local DB
local AUDIT_VERSION = 2026073020

-- On the 3.3.5 client SavedVariables are not guaranteed to be available while
-- the add-on's top-level chunk is executing.  Capturing the temporary table
-- here would let the later SavedVariables load replace the global and make
-- every audit update disappear on logout.  Bind the local only after this
-- add-on's ADDON_LOADED event, when the persisted table is authoritative.
local function InitializeAuditDB()
    KajigeUntranslatedAuditDB = KajigeUntranslatedAuditDB or {}
    DB = KajigeUntranslatedAuditDB
    if DB.version ~= AUDIT_VERSION then
        DB.entries = {}
        DB.total = 0
        DB.dropped = 0
    end
    DB.entries = DB.entries or {}
    DB.total = DB.total or 0
    DB.version = AUDIT_VERSION
end

