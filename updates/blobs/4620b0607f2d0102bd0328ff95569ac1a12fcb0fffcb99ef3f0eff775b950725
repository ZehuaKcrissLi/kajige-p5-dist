local function FunctionalChineseText(visible)
    if type(visible) ~= "string" or visible == "" then return end
    if uiExact[visible] then return uiExact[visible] end
    local playerNumber, playerPercent = string.match(
        visible,
        "^Player%s+(%d+)%s*(%%?)$"
    )
    if playerNumber then
        return "玩家 " .. playerNumber
            .. (playerPercent == "%" and " %" or "")
    end
    local channel, channelName = string.match(
        visible,
        "^([%d#]+)%.%s*([A-Za-z]+)$"
    )
    if channel and channelNames and channelNames[channelName] then
        return channel .. ". " .. channelNames[channelName]
    end
    -- Audit normalization collapses whitespace and dynamic numbers to '#'.
    -- Use the same representation as a second lookup so templated/hidden
    -- FontStrings such as "Player 17" and "#. General" do not survive merely
    -- because their raw formatting differs from the display table.
    local normalized = Normalize(visible)
    if uiExact[normalized] then return uiExact[normalized] end
    channel, channelName = string.match(
        normalized,
        "^(#)%.%s*([A-Za-z]+)$"
    )
    if channel and channelNames and channelNames[channelName] then
        return channel .. ". " .. channelNames[channelName]
    end
    local page = string.match(visible, "^Page%s+(%d+)$")
    if page then return "第 " .. page .. " 页" end
    local health = string.match(visible, "^Health%s+([%d%.]+%%)$")
    if health then return "生命值 " .. health end
    local battlegroundLore = string.match(visible, "^BATTLEGROUND_LORETEXT_(%d+)$")
    if battlegroundLore then return "战场说明 " .. battlegroundLore end
    local bobbyLevel = string.match(
        visible,
        "^Bobby The Fleshripper %(Level (%d+) Raptor%)$"
    )
    if bobbyLevel then
        return "撕裂者博比（" .. bobbyLevel .. "级迅猛龙）"
    end
    if visible == "HONOR_THISWEEK" then return "本周荣誉" end
    if EpochCN then
        local localized = EpochCN.localizedTextByRaw
            and EpochCN.localizedTextByRaw[visible]
        if type(localized) == "string" and localized ~= visible then
            return localized
        end
        if EpochCN.NormalizeDisplayText and EpochCN.localizedTextByRaw then
            local normalized = EpochCN:NormalizeDisplayText(visible)
            localized = EpochCN.localizedTextByRaw[normalized]
            if type(localized) == "string" and localized ~= visible then
                return localized
            end
        end
    end
    local glossary = EpochCN_Glossary and EpochCN_Glossary.text
    if glossary and glossary[visible] then return glossary[visible] end
    local map = EpochCN_Overrides and EpochCN_Overrides.maps
    if map and map[visible] then return map[visible] end
    local translated = Translate(visible)
    if translated then return translated end
    translated = ItemChineseName(visible)
    if translated ~= visible then return translated end
end

