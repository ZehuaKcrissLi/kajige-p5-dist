local function TranslateVisibleUI()
    if not EnumerateFrames then return 0, 0 end
    -- FolderPickerButton01 owns an immutable child FontString in build 12340.
    -- Localize through the button API before enumerating its regions.
    local folderPickerConfirm = getglobal
        and getglobal("FolderPickerButton01")
        or nil
    if folderPickerConfirm and folderPickerConfirm.SetText then
        pcall(folderPickerConfirm.SetText, folderPickerConfirm, "是")
    end
    local frame
    local translated = 0
    local missing = 0
    while true do
        frame = EnumerateFrames(frame)
        if not frame then break end
        if not BelongsToChatFrame(frame) and frame.GetRegions then
            local regions = {frame:GetRegions()}
            for _, region in ipairs(regions) do
                if region and region.GetObjectType and region:GetObjectType() == "FontString"
                    and region.GetText and region.SetText
                    and not BelongsToChatFrame(region) then
                    local text = region:GetText()
                    local visible = VisibleText(text)
                    visible = string.gsub(visible, "^%s+", "")
                    visible = string.gsub(visible, "%s+$", "")
                    local replacement = FunctionalChineseText(visible)
                    if replacement and replacement ~= visible then
                        local ok = pcall(region.SetText, region, replacement)
                        if ok then
                            translated = translated + 1
                        else
                            local frameName = frame.GetName
                                and frame:GetName()
                                or "<anonymous-frame>"
                            local parent = region.GetParent
                                and region:GetParent()
                                or nil
                            local parentName = parent and parent.GetName
                                and parent:GetName()
                                or "<anonymous-parent>"
                            Audit(
                                "UNWRITABLE_UI[" .. tostring(frameName)
                                    .. "/" .. tostring(parentName) .. "]",
                                text
                            )
                        end
                    elseif type(text) == "string"
                        and string.len(text) >= 4
                        and string.find(text, "[A-Za-z]")
                        and not string.find(text, "^%d")
                        and not string.find(text, "^#?[%d%.]+[KkMm]?$")
                        and not string.find(text, "^Details! v")
                        and not string.find(text, "^|H") then
                            local audited = Audit(
                                frame.IsVisible and frame:IsVisible()
                                    and "VISIBLE_UI"
                                    or "INSTANTIATED_UI",
                                text
                            )
                            if audited then missing = missing + 1 end
                    end
                end
            end
        end
    end
    DB.lastUIScan = {
        translated = translated,
        missing = missing,
        at = date("%Y-%m-%d %H:%M:%S"),
    }
    return translated, missing
end

