-- Batch E2E evidence: retain a bounded 120-second FPS window plus the current
-- real raid/party size and player buffs. This replaces repeated screenshots
-- with machine-readable SavedVariables and contains no credentials.
local performanceProbe = CreateFrame("Frame")
local performanceElapsed = 0
performanceProbe:SetScript("OnUpdate", function(_, delta)
    performanceElapsed = performanceElapsed + delta
    if performanceElapsed < 1 or not DB then return end
    performanceElapsed = performanceElapsed - 1

    DB.performance = DB.performance or {}
    local performance = DB.performance
    performance.samples = performance.samples or {}
    local fps = GetFramerate and GetFramerate() or 0
    if type(fps) ~= "number" then fps = 0 end
    table.insert(performance.samples, fps)
    while #performance.samples > 120 do
        table.remove(performance.samples, 1)
    end

    local sum
    local minimum
    sum = 0
    for _, sample in ipairs(performance.samples) do
        sum = sum + sample
        if not minimum or sample < minimum then minimum = sample end
    end
    performance.average = #performance.samples > 0
        and sum / #performance.samples
        or 0
    performance.minimum = minimum or 0
    performance.count = #performance.samples
    performance.raidMembers = GetNumRaidMembers
        and GetNumRaidMembers()
        or 0
    performance.partyMembers = GetNumPartyMembers
        and GetNumPartyMembers()
        or 0
    performance.groupKind = performance.raidMembers > 0
        and "raid"
        or (performance.partyMembers > 0 and "party" or "solo")
    local rawZone = GetRealZoneText and GetRealZoneText() or ""
    performance.zone = FunctionalChineseText(rawZone) or rawZone
    performance.sampledAt = date("%Y-%m-%d %H:%M:%S")

    local buffs = {}
    if UnitBuff then
        for index = 1, 40 do
            local name, _, _, _, _, _, _, _, _, _, spellID =
                UnitBuff("player", index)
            if not name then break end
            buffs[#buffs + 1] = {
                name = LocalizeAbilityName(name),
                spellID = spellID,
            }
        end
    end
    performance.playerBuffs = buffs
end)

