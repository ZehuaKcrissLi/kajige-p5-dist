local function VisibleText(message)
    if type(message) ~= "string" then return "" end
    local text = string.gsub(message, "|H.-|h(.-)|h", "%1")
    text = string.gsub(text, "|T.-|t", "")
    text = string.gsub(text, "|c%x%x%x%x%x%x%x%x", "")
    text = string.gsub(text, "|r", "")
    return text
end

local function Normalize(message)
    local text = VisibleText(message)
    text = string.gsub(text, "%d+", "#")
    text = string.gsub(text, "%s+", " ")
    text = string.gsub(text, "^%s+", "")
    text = string.gsub(text, "%s+$", "")
    if string.len(text) > 240 then text = string.sub(text, 1, 240) end
    return text
end

local function HasUnapprovedEnglish(message)
    local normalized = Normalize(message)
    -- Remove complete URLs before slash-command handling.  Removing /support
    -- first mutilated an otherwise ignorable Chinese help URL and left
    -- fragments such as "http" and "locale" to be counted as untranslated.
    local englishProbe = string.gsub(normalized, "https?://[^%s，。]+", "")
    -- Slash/dot command names and their ASCII arguments are protocol tokens,
    -- not untranslated prose.  Strip the complete command fragment so text
    -- such as "输入 /kjgtitan apply。" does not leave a false-positive
    -- trailing "apply".
    englishProbe = string.gsub(
        englishProbe,
        "/[A-Za-z][A-Za-z%d_]*[%sA-Za-z%d_%.%-]*",
        ""
    )
    englishProbe = string.gsub(
        englishProbe,
        "%.[A-Za-z][A-Za-z%d_]*[%sA-Za-z%d_%.%-]*",
        ""
    )
    englishProbe = string.gsub(
        englishProbe,
        "%f[%a]kjg%s+[%w%s]+",
        ""
    )
    englishProbe = string.gsub(englishProbe, "%f[%a]news%f[%A]", "")
    for _, approved in ipairs({
        "KJG", "DPS", "TPS", "UI", "WA", "DBM", "FPS", "GM", "ID",
        "API", "ElvUI", "WeakAuras", "Details", "Discord", "iTunes",
        "Mac", "PvP", "NPC", "CF", "ALT", "SHIFT", "BigWigs", "stats",
        "Terciob",
    }) do
        englishProbe = string.gsub(
            englishProbe,
            "%f[%a]" .. approved .. "%f[%A]",
            ""
        )
    end
    englishProbe = string.gsub(englishProbe, "%f[%a]P%d%f[%A]", "")
    englishProbe = string.gsub(englishProbe, "%f[%a]T%d%f[%A]", "")
    englishProbe = string.gsub(englishProbe, "%f[%a][A-Za-z]%f[%A]", "")
    return normalized, string.find(englishProbe, "[A-Za-z]") ~= nil
end

local function Audit(source, message)
    local normalized = Normalize(message)
    local _, hasEnglish = HasUnapprovedEnglish(normalized)
    if normalized == "" or not hasEnglish then return false end
    local key = source .. ":" .. normalized
    local entry = DB.entries[key]
    if entry then
        entry.count = entry.count + 1
        entry.lastSeen = date("%Y-%m-%d %H:%M:%S")
        return true
    end
    local count = 0
    for _ in pairs(DB.entries) do count = count + 1 end
    if count >= MAX_ENTRIES then
        DB.dropped = (DB.dropped or 0) + 1
        return true
    end
    DB.entries[key] = {
        source = source,
        text = normalized,
        count = 1,
        zone = GetRealZoneText and GetRealZoneText() or "",
        firstSeen = date("%Y-%m-%d %H:%M:%S"),
        lastSeen = date("%Y-%m-%d %H:%M:%S"),
    }
    DB.total = DB.total + 1
    return true
end

