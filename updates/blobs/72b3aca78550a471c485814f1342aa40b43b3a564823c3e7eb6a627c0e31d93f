function SunwellTrainer_ShowBotSpec(name, classToken)
    local specs = botSpecs[classToken]
    if not specs then
        systemMessage("无法识别目标职业。", true)
        return
    end

    botSpecFrame.botName = name
    botSpecTitle:SetText(name .. " - PVE 天赋/装备/走位")
    for index = 1, 4 do
        local button = botSpecButtons[index]
        local spec = specs[index]
        if spec then
            button.specName = spec[2]
            button:SetText(spec[1])
            button:Show()
        else
            button.specName = nil
            button:Hide()
        end
    end
    botSpecFrame:Show()
end

