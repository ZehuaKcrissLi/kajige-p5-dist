local queue = {}
local elapsed = 0

local function systemMessage(message, errorColor)
    local color = errorColor and "|cffff5555" or "|cff33ff99"
    DEFAULT_CHAT_FRAME:AddMessage(color .. "咔鸡哥训练服：|r " .. message)
end

local function sendCommand(command)
    SendChatMessage(command, "SAY")
end

local function groupChannel()
    if GetNumRaidMembers() > 0 then
        return "RAID"
    end
    if GetNumPartyMembers() > 0 then
        return "PARTY"
    end
end

local function sendGroupBotCommand(command)
    local channel = groupChannel()
    if not channel then
        systemMessage("当前没有机器人队伍。", true)
        return false
    end
    SendChatMessage(command, channel)
    return true
end

local queueFrame = CreateFrame("Frame")
queueFrame:SetScript("OnUpdate", function(self, delta)
    if #queue == 0 then
        return
    end

    elapsed = elapsed + delta
    if elapsed < 0.80 then
        return
    end

    elapsed = 0
    local action = table.remove(queue, 1)
    if action.kind == "bot" then
        sendGroupBotCommand(action.command)
    else
        sendCommand(action.command)
    end
end)

local function queueCommand(command)
    table.insert(queue, { kind = "server", command = command })
end

local function queueBotCommand(command)
    table.insert(queue, { kind = "bot", command = command })
end

local function queueCommands(commands)
    for _, command in ipairs(commands) do
        queueCommand(command)
    end
end

local function currentGroupSize()
    local raidCount = GetNumRaidMembers()
    if raidCount and raidCount > 0 then
        local onlineCount = 0
        for index = 1, raidCount do
            local _, _, _, _, _, _, _, online = GetRaidRosterInfo(index)
            if online then
                onlineCount = onlineCount + 1
            end
        end
        return math.max(onlineCount, 1)
    end

    local onlineCount = 1
    for index = 1, (GetNumPartyMembers() or 0) do
        if UnitIsConnected("party" .. index) then
            onlineCount = onlineCount + 1
        end
    end
    return onlineCount
end

local balancedRoster = {
    "warrior", "paladin", "priest", "shaman", "druid",
    "warrior", "paladin", "priest", "shaman", "hunter",
    "paladin", "priest", "shaman", "druid", "mage",
    "paladin", "hunter", "mage", "warlock", "rogue",
    "deathknight", "warlock", "rogue", "deathknight"
}

local classCommand = {
    deathknight = "dk"
}

local function fillRoster(targetSize)
    local current = currentGroupSize()
    if targetSize <= current then
        systemMessage("当前已有 " .. current .. " 人；如需缩编，请先点击“清空机器人”。", true)
        return
    end

    local needed = targetSize - current
    local nextRosterIndex = ((current - 1) % #balancedRoster) + 1
    if current == 1 then
        local firstClass = balancedRoster[1]
        queueCommand(".playerbots bot addclass " .. (classCommand[firstClass] or firstClass))
        queueCommand(".swp raid")
        needed = needed - 1
        nextRosterIndex = 2
    elseif GetNumRaidMembers() == 0 then
        queueCommand(".swp raid")
    end

    for index = 1, needed do
        local rosterIndex = ((nextRosterIndex + index - 2) % #balancedRoster) + 1
        local className = balancedRoster[rosterIndex]
        queueCommand(".playerbots bot addclass " .. (classCommand[className] or className))
    end
    systemMessage("正在把团队补到 " .. targetSize .. " 人；无需先邀请朋友。")
end

