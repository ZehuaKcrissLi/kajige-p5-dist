local function UpdateBossHealth()
    local units = {"target", "focus", "mouseover", "boss1", "boss2", "boss3", "boss4"}
    local raidCount = GetNumRaidMembers and GetNumRaidMembers() or 0
    for index = 1, raidCount do table.insert(units, "raid" .. index .. "target") end
    for _, unit in ipairs(units) do
        if UnitExists(unit) then
            local creatureID = CreatureID(UnitGUID(unit))
            if creatureID == DRAGON_ID or creatureID == DEMON_ID then
                local maximum = UnitHealthMax(unit)
                if maximum and maximum > 0 then
                    local percent = UnitHealth(unit) * 100 / maximum
                    if creatureID == DRAGON_ID then
                        state.health.dragon = percent
                        state.healthUpdatedAt.dragon = GetTime()
                        state.healthSeen.dragon = true
                    else
                        state.health.demon = percent
                        state.healthUpdatedAt.demon = GetTime()
                        state.healthSeen.demon = true
                    end
                end
            end
        end
    end

    local dragon = state.health.dragon
    local demon = state.health.demon
    if not dragon or not demon then return end
    local now = GetTime()
    if not state.healthUpdatedAt.dragon or not state.healthUpdatedAt.demon
        or now - state.healthUpdatedAt.dragon > 5
        or now - state.healthUpdatedAt.demon > 5 then
        return
    end
    if math.min(dragon, demon) <= 25 then
        local gap = math.abs(dragon - demon)
        if gap > state.metrics.maximumHealthGap then state.metrics.maximumHealthGap = gap end
        if not state.balanceCallChecked and math.min(dragon, demon) <= 20 and gap >= 8 then
            state.balanceCallChecked = true
            local expected = dragon < demon and "outstop" or "instop"
            AddPending(
                expected, now, Profile().responseWindow, 3,
                "sync", 7,
                "末段血量差达到 8% 后没有叫停血量较低的一侧"
            )
            RaidNotice(dragon < demon and "外场停手，内场追血" or "内场停手，外场追血", 3)
        end
    end
    if not state.finalStartedAt and (dragon <= 10 or demon <= 10) then
        state.finalStartedAt = now
        state.firstThreshold = dragon <= 10 and "外场龙" or "内场恶魔"
        AddPending(
            "push", now, Profile().responseWindow, 3,
            "sync", 7,
            "第一边进入 10% 阈值后没有立即下达双边推进口令"
        )
        RaidNotice(state.firstThreshold .. "已进入阈值：另一边立刻全开", 3)
    end
    if state.finalStartedAt and not state.finalCompleted and dragon <= 10 and demon <= 10 then
        state.finalCompleted = true
        state.metrics.finalExposure = now - state.finalStartedAt
        if state.metrics.finalExposure > 20 then
            AddPenalty("sync", 20, "双边 10% 阈值不同步超过 20 秒", "final-exposure")
        elseif state.metrics.finalExposure > 10 then
            AddPenalty("sync", 12, "双边 10% 阈值不同步超过 10 秒", "final-exposure")
        elseif state.metrics.finalExposure > 6 then
            AddPenalty("sync", 6, "双边 10% 阈值不同步超过 6 秒", "final-exposure")
        end
    end
end

local function AuditRoster(silent)
    RefreshRosterRoles()
    local counts = RosterCounts()
    local wanted = Profile()
    local known = counts.TANK + counts.HEALER + counts.DAMAGER
    local total = known + counts.UNKNOWN
    local message = string.format(
        "%s：已识别 %dT/%dH/%dD，未知 %d；建议 %dT/%dH。",
        wanted.label,
        counts.TANK,
        counts.HEALER,
        counts.DAMAGER,
        counts.UNKNOWN,
        wanted.tanks,
        wanted.healers
    )
    if not silent then Print(message, known > 0 and (counts.TANK < wanted.tanks or counts.HEALER < wanted.healers)) end
    if state.active and total >= 20 and counts.UNKNOWN <= 3 then
        if counts.TANK < wanted.tanks then
            AddPenalty("coverage", 8, "开打阵容少于 " .. wanted.tanks .. " 名可识别坦克", "roster-tanks")
        end
        if counts.HEALER < wanted.healers then
            AddPenalty("coverage", 6, "普通开荒配置少于 " .. wanted.healers .. " 名可识别治疗", "roster-healers")
        end
    end
    return message
end

local function BuildReport(success)
    local duration = (state.endedAt or GetTime()) - state.startedAt
    local lines = {
        (success and "|cff33ff99击杀复盘|r" or "|cffff5555灭团复盘|r")
            .. "　" .. Profile().label .. "　用时 " .. FormatSeconds(duration) .. " 秒",
        string.format(
            "总分 %d　门组 %d　覆盖 %d　诅咒 %d　同步 %d　口令 %d",
            OverallScore(), state.score.portal, state.score.coverage,
            state.score.curse, state.score.sync, state.score.command
        ),
        string.format(
            "传送门 %d：预警 %d / 授权 %d / 薄门 %d / 疲劳误进 %d",
            state.metrics.portalRounds, state.metrics.portalPrecalled,
            state.metrics.portalAuthorized, state.metrics.thinPortals,
            state.metrics.exhaustedEntries
        ),
        string.format(
            "诅咒：点名 %d / 及时隔离 %d / 转移 %d / 授权驱散 %d / 未授权 %d",
            state.metrics.curseApplications, state.metrics.curseCalled,
            state.metrics.curseTransfers, state.metrics.controlledDispels,
            state.metrics.uncontrolledDispels
        ),
        string.format(
            "内坦：腐化打击 %d / 有口令 %d　覆盖中断 %d　高层清层 %d",
            state.metrics.strikes, state.metrics.strikeCalls,
            state.metrics.coverageBreaks, state.metrics.highStackClears
        ),
    }
    if state.healthSeen.dragon and state.healthSeen.demon then
        table.insert(lines, string.format(
            "双血量：25%% 后最大差 %.1f%%　阈值暴露 %s 秒",
            state.metrics.maximumHealthGap,
            state.metrics.finalExposure and FormatSeconds(state.metrics.finalExposure) or "未完成/未观测"
        ))
    else
        table.insert(lines, "双血量：未同时观测到龙和恶魔；请让团长目标一侧、焦点另一侧。")
    end
    if state.firstDeath then
        table.insert(lines, "第一减员：" .. state.firstDeath .. " ← " .. (state.firstDeathCause or "未知"))
    else
        table.insert(lines, "第一减员：无")
    end
    if #state.penalties > 0 then
        table.insert(lines, "主要扣分：")
        local first = math.max(1, #state.penalties - 3)
        for index = first, #state.penalties do
            local item = state.penalties[index]
            table.insert(lines, string.format("- %.1fs　%s（-%d）", item.at, item.reason, item.points))
        end
    else
        table.insert(lines, "没有记录到可识别的指挥失误。")
    end
    return table.concat(lines, "\n")
end

local function SaveReport(success)
    local report = {
        timestamp = date and date("%Y-%m-%d %H:%M:%S") or "",
        success = success,
        profile = DB.profile,
        score = OverallScore(),
        text = BuildReport(success),
    }
    DB.lastReport = report
    table.insert(DB.history, 1, report)
    while #DB.history > 10 do table.remove(DB.history) end
    state.lastReport = report.text
    if reportText then reportText:SetText(report.text) end
    return report
end

local function EndEncounter(success)
    if not state.active then return end
    local now = GetTime()
    state.success = success and true or false
    state.endedAt = now
    if state.finalStartedAt and not state.finalCompleted then
        local exposure = now - state.finalStartedAt
        state.metrics.finalExposure = exposure
        if exposure > 20 then
            AddPenalty("sync", 20, "战斗结束时第二边仍未完成 10% 阈值", "final-exposure")
        elseif exposure > 10 then
            AddPenalty("sync", 12, "末段阈值不同步超过 10 秒", "final-exposure")
        end
    end
    if state.healthSeen.dragon and state.healthSeen.demon
        and state.metrics.maximumHealthGap > 15 then
        AddPenalty("sync", 8, "25% 后双边最大血量差超过 15%", "maximum-health-gap")
    end
    ProcessPendingChecks(now)
    local report = SaveReport(success)
    state.active = false
    encounterClosedUntil = now + 10
    Print((success and "击杀完成，" or "战斗结束，") .. "本轮指挥得分 " .. report.score .. "。")
    if frame then frame:Show() end
end

local function IsPlayer(flags, guid)
    if flags and COMBATLOG_OBJECT_TYPE_PLAYER and bit and bit.band then
        return bit.band(flags, COMBATLOG_OBJECT_TYPE_PLAYER) > 0
    end
    return type(guid) == "string" and string.sub(guid, 1, 3) == "0x0"
end

local function HandleCombatLog(...)
    local timestamp, subEvent, sourceGUID, sourceName, sourceFlags,
        destGUID, destName, destFlags, spellID = ...
    local now = GetTime()
    local sourceID = CreatureID(sourceGUID)
    local destID = CreatureID(destGUID)
    if not state.active and (sourceID == DRAGON_ID or sourceID == DEMON_ID
        or destID == DRAGON_ID or destID == DEMON_ID) then
        Activate("战斗日志")
    end
    if not state.active then return end

    if subEvent == "UNIT_DIED" then
        if destID == DEMON_ID then
            EndEncounter(true)
            return
        end
        if IsPlayer(destFlags, destGUID) then RecordDeath(destGUID, destName, now) end
        return
    end

    if subEvent == "SWING_DAMAGE" or string.find(subEvent or "", "_DAMAGE", 1, true) then
        if IsPlayer(destFlags, destGUID) then
            state.lastDamage[destGUID] = {
                at = now,
                spellID = subEvent == "SWING_DAMAGE" and nil or spellID,
                label = DamageLabel(spellID, subEvent),
            }
        end
    end

    if not spellID then return end
    if spellID == SPELL.SPECTRAL_BLAST
        and (subEvent == "SPELL_DAMAGE" or subEvent == "SPELL_MISSED"
            or subEvent == "SPELL_CAST_SUCCESS") then
        OpenPortal(now)
    elseif spellID == SPELL.SPECTRAL_REALM then
        if subEvent == "SPELL_AURA_APPLIED" then
            if not state.portalLastAt or now - state.portalLastAt > 8 then OpenPortal(now) end
            state.realm[destGUID] = {name = ShortName(destName), inside = true, since = now}
            state.buffet[destGUID] = nil
            AddPortalEntrant(destGUID, destName, now)
        elseif subEvent == "SPELL_AURA_REMOVED" then
            state.realm[destGUID] = {name = ShortName(destName), inside = false, since = now}
        end
    elseif spellID == SPELL.SPECTRAL_EXHAUSTION then
        if subEvent == "SPELL_AURA_APPLIED" or subEvent == "SPELL_AURA_REFRESH" then
            state.exhaustion[destGUID] = now + 60
        elseif subEvent == "SPELL_AURA_REMOVED" then
            state.exhaustion[destGUID] = nil
        end
    elseif spellID == SPELL.ARCANE_BUFFET then
        if subEvent == "SPELL_AURA_APPLIED" then
            state.buffet[destGUID] = 1
        elseif subEvent == "SPELL_AURA_APPLIED_DOSE" then
            local amount = select(13, ...)
            state.buffet[destGUID] = tonumber(amount) or ((state.buffet[destGUID] or 1) + 1)
        elseif subEvent == "SPELL_AURA_REMOVED" then
            state.buffet[destGUID] = nil
        end
    elseif spellID == SPELL.CURSE_DIRECT and subEvent == "SPELL_AURA_APPLIED" then
        RecordCurse(destGUID, destName, spellID, now)
    elseif spellID == SPELL.CURSE_CHAIN
        and (subEvent == "SPELL_AURA_APPLIED" or subEvent == "SPELL_DAMAGE") then
        RecordCurseTransfer(sourceName, destGUID, destName, now)
    elseif (spellID == SPELL.CURSE_DIRECT or spellID == SPELL.CURSE_CHAIN)
        and subEvent == "SPELL_AURA_REMOVED" then
        state.curses[destGUID] = nil
    elseif spellID == SPELL.CORRUPTING_STRIKE
        and (subEvent == "SPELL_AURA_APPLIED" or subEvent == "SPELL_DAMAGE") then
        RecordStrike(now)
    elseif spellID == SPELL.CRAZED_RAGE
        and (subEvent == "SPELL_AURA_APPLIED" or subEvent == "SPELL_AURA_APPLIED_DOSE") then
        local amount = select(13, ...)
        state.rageAt = state.rageAt or now
        state.rageStack = tonumber(amount) or math.max(1, state.rageStack + 1)
        if not state.finalStartedAt then
            state.finalStartedAt = now
            state.firstThreshold = "狂暴侧"
            AddPending("push", now, Profile().responseWindow, 3, "sync", 7,
                "疯狂怒火出现后没有立即下达双边推进口令")
        end
    elseif WILD_MAGIC[spellID] and subEvent == "SPELL_AURA_APPLIED" then
        state.lastWildMagic = WILD_MAGIC[spellID] .. " → " .. ShortName(destName)
        state.lastWildMagicAt = now
    end

    if subEvent == "SPELL_DISPEL" then
        local extraSpellID = select(12, ...)
        RecordDispel(extraSpellID, destName, now)
    end
end

local function CheckBossUnit(unit)
    if not UnitExists(unit) then return false end
    local creatureID = CreatureID(UnitGUID(unit))
    if creatureID == DRAGON_ID or creatureID == DEMON_ID then
        if UnitAffectingCombat and UnitAffectingCombat(unit) then Activate("单位进入战斗") end
        return true
    end
    return false
end

local function CurrentCurseStatus()
    local now = GetTime()
    local count = 0
    local oldest = 0
    for _, curse in pairs(state.curses) do
        count = count + 1
        oldest = math.max(oldest, now - curse.appliedAt)
    end
    return count, oldest
end

local function UpdateTexts()
    if not stateText then return end
    local roster = RosterCounts()
    local realm = RealmCounts()
    local curseCount, curseAge = CurrentCurseStatus()
    local now = GetTime()
    local healthDragon = state.health.dragon and string.format("%.1f%%", state.health.dragon) or "--"
    local healthDemon = state.health.demon and string.format("%.1f%%", state.health.demon) or "--"
    local nextPortal = "--"
    if state.active and state.nextPortalMinimum then
        nextPortal = FormatSeconds(state.nextPortalMinimum - now)
            .. "～" .. FormatSeconds(state.nextPortalMaximum - now) .. " 秒"
    end
    local combatLine
    if state.active then
        combatLine = "战斗 " .. FormatSeconds(now - state.startedAt) .. " 秒"
            .. "　下一门 " .. nextPortal
            .. "　当前第 " .. state.portalNumber .. " 门"
    else
        combatLine = "未在战斗　下一次开战将自动清空状态并开始评分"
    end
    stateText:SetText(
        "|cffffd100" .. Profile().label .. "|r　" .. combatLine .. "\n"
        .. string.format(
            "内场 %d 人（%dT/%dH）　外场 %dT/%dH　疲劳 %d　奥术高层 %d",
            realm.inside, realm.insideTanks, realm.insideHealers,
            realm.outsideTanks, realm.outsideHealers,
            realm.exhausted, realm.highBuffet
        ) .. "\n"
        .. "龙 " .. healthDragon .. "　恶魔 " .. healthDemon
        .. "　活动诅咒 " .. curseCount .. "（最长 " .. FormatSeconds(curseAge) .. " 秒）\n"
        .. string.format(
            "阵容识别 %dT/%dH/%dD/?%d　目标 %dT/%dH",
            roster.TANK, roster.HEALER, roster.DAMAGER, roster.UNKNOWN,
            Profile().tanks, Profile().healers
        )
    )
    scoreText:SetText(string.format(
        "|cff33ff99当前 %d 分|r　门组 %d　覆盖 %d　诅咒 %d　同步 %d　口令 %d",
        OverallScore(), state.score.portal, state.score.coverage,
        state.score.curse, state.score.sync, state.score.command
    ))
    if state.active then
        reportText:SetText(
            "点击下方口令会记录反应时间，并在开启广播时发到团队。\n"
            .. "团长最好把龙设为目标、恶魔设为焦点，才能评分双血量同步。"
        )
    elseif DB.lastReport then
        reportText:SetText(DB.lastReport.text)
    else
        reportText:SetText("暂无复盘。进入卡雷苟斯战斗后自动开始。")
    end
    if profileButton then profileButton:SetText("模式：" .. Profile().label) end
    if broadcastButton then broadcastButton:SetText("口令广播：" .. (DB.broadcast and "开" or "关")) end
end

