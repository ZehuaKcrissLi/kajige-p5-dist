local function CreatureID(guid)
    if type(guid) ~= "string" or string.sub(guid, 1, 4) ~= "0xF1" then return nil end
    return tonumber(string.sub(guid, 7, 12), 16)
end

local function CountKeys(values)
    local count = 0
    for _ in pairs(values or {}) do count = count + 1 end
    return count
end

local function Clamp(value, minimum, maximum)
    if value < minimum then return minimum end
    if value > maximum then return maximum end
    return value
end

local function ShortName(name)
    if type(name) ~= "string" then return "未知" end
    return string.match(name, "^[^-]+") or name
end

local function FormatSeconds(value)
    if not value then return "--" end
    if value < 0 then value = 0 end
    return string.format("%.1f", value)
end

local function Print(message, bad)
    local color = bad and "|cffff5555" or "|cff33ff99"
    if DEFAULT_CHAT_FRAME then
        DEFAULT_CHAT_FRAME:AddMessage(color .. "卡雷指挥训练：|r " .. tostring(message))
