local function Broadcast(message)
    if not DB.broadcast then return end
    local raidCount = GetNumRaidMembers and GetNumRaidMembers() or 0
    if raidCount > 0 then
        if (IsRaidLeader and IsRaidLeader()) or (IsRaidOfficer and IsRaidOfficer()) then
            SendChatMessage(message, "RAID_WARNING")
        else
            SendChatMessage(message, "RAID")
        end
    elseif (GetNumPartyMembers and GetNumPartyMembers() or 0) > 0 then
        SendChatMessage(message, "PARTY")
    end
end

local function RecordCall(kind, silent)
    local definition = callDefinitions[kind]
    if not definition then return false end
    local now = GetTime()
    state.lastCall[kind] = now
    table.insert(state.callLog, {
        at = state.startedAt > 0 and now - state.startedAt or 0,
        kind = kind,
        label = definition.label,
    })
    if #state.callLog > 40 then table.remove(state.callLog, 1) end
    if not silent then
        Broadcast(definition.message)
        Print(definition.label .. "：" .. definition.message)
    end
    return true
end

local function CallWithin(kind, fromTime, toTime)
    local value = state.lastCall[kind]
    return value and value >= fromTime and value <= toTime
end

local function AddPending(kind, eventAt, wait, lead, category, points, reason, metric)
    table.insert(state.pendingChecks, {
        at = eventAt + wait,
        kind = kind,
        fromTime = eventAt - (lead or 0),
        toTime = eventAt + wait,
        category = category,
        points = points,
        reason = reason,
        metric = metric,
    })
end

local function ProcessPendingChecks(now)
    local remaining = {}
    for _, check in ipairs(state.pendingChecks) do
        if now >= check.at then
            if CallWithin(check.kind, check.fromTime, check.toTime) then
                if check.metric then
                    state.metrics[check.metric] = (state.metrics[check.metric] or 0) + 1
                end
            else
                AddPenalty(check.category, check.points, check.reason)
            end
        else
            table.insert(remaining, check)
        end
    end
    state.pendingChecks = remaining
end

local function Activate(reason)
    if state.active then return end
    if GetTime() < encounterClosedUntil then return end
    state = NewState()
    state.active = true
    state.startedAt = GetTime()
    state.nextPortalMinimum = state.startedAt + Profile().firstPortalMinimum
    state.nextPortalMaximum = state.startedAt + Profile().firstPortalMaximum
    state.activationReason = reason
    RefreshRosterRoles()
    if DB.autoShow and frame then frame:Show() end
    Print("战斗状态机启动：" .. Profile().label .. "。第一门约 13～15 秒。")
    RaidNotice("卡雷苟斯：外坦接龙，内坦与一门治疗准备", 2)
end

local function PortalEntrantCount(portal)
    return portal and CountKeys(portal.entrants) or 0
end

local function OpenPortal(now)
    if not state.active then Activate("传送门") end
    if state.portalLastAt and now - state.portalLastAt < 8 then return state.currentPortal end
    state.portalNumber = state.portalNumber + 1
    state.portalLastAt = now
    state.metrics.portalRounds = state.metrics.portalRounds + 1
    state.currentPortal = {
        number = state.portalNumber,
        startedAt = now,
        entrants = {},
        finalized = false,
    }
    state.nextPortalMinimum = now + Profile().portalMinimum
    state.nextPortalMaximum = now + Profile().portalMaximum

    if CallWithin("ready", now - 10, now + 0.2) then
        state.metrics.portalPrecalled = state.metrics.portalPrecalled + 1
    else
        AddPenalty("command", 5, "第 " .. state.portalNumber .. " 门前没有门组准备口令")
    end
    AddPending(
        "enter", now, Profile().responseWindow, 3,
        "command", 5,
        "第 " .. state.portalNumber .. " 门没有明确授权进门",
        "portalAuthorized"
    )
    RaidNotice("第 " .. state.portalNumber .. " 门已出现：只进指定组", 3)
    return state.currentPortal
end

local function AddPortalEntrant(guid, name, now)
    local portal = state.currentPortal
    if not portal or now - portal.startedAt > 8 then portal = OpenPortal(now) end
    if not portal or portal.entrants[guid] then return end
    local exhaustedUntil = state.exhaustion[guid]
    portal.entrants[guid] = {
        name = ShortName(name),
        role = RoleForName(name),
        buffet = state.buffet[guid] or 0,
    }
    if exhaustedUntil and exhaustedUntil > now then
        state.metrics.exhaustedEntries = state.metrics.exhaustedEntries + 1
        AddPenalty(
            "portal", 12,
            ShortName(name) .. " 带幽灵疲劳进入第 " .. portal.number .. " 门"
        )
    end
    if (state.buffet[guid] or 0) >= Profile().buffetHigh then
        state.metrics.highStackClears = state.metrics.highStackClears + 1
    end
end

local function FinalizePortal(portal)
    if not portal or portal.finalized then return end
    portal.finalized = true
    local entrantCount = PortalEntrantCount(portal)
    local tanks = 0
    local healers = 0
    for _, entrant in pairs(portal.entrants) do
        if entrant.role == "TANK" then tanks = tanks + 1 end
        if entrant.role == "HEALER" then healers = healers + 1 end
    end
    portal.count = entrantCount
    portal.tanks = tanks
    portal.healers = healers

    if entrantCount < Profile().minimumEntrants then
        state.metrics.thinPortals = state.metrics.thinPortals + 1
        AddPenalty(
            "portal", 6,
            "第 " .. portal.number .. " 门仅进入 " .. entrantCount .. " 人，普通团容错不足"
        )
    end

    local roster = RosterCounts()
    local realm = RealmCounts()
    if portal.number == 1 and roster.TANK > 0 and tanks == 0 then
        state.metrics.coverageBreaks = state.metrics.coverageBreaks + 1
        AddPenalty("coverage", 15, "第一门没有可识别的内坦")
    end
    if roster.HEALER > 0 and realm.insideHealers == 0 then
        state.metrics.coverageBreaks = state.metrics.coverageBreaks + 1
        AddPenalty("coverage", 12, "第 " .. portal.number .. " 门后内场没有可识别治疗")
    end
    if roster.TANK >= Profile().tanks and realm.outsideTanks == 0 then
        state.metrics.coverageBreaks = state.metrics.coverageBreaks + 1
        AddPenalty("coverage", 15, "第 " .. portal.number .. " 门后外场断坦")
    end
    if roster.HEALER >= Profile().healers and realm.outsideHealers == 0 then
        state.metrics.coverageBreaks = state.metrics.coverageBreaks + 1
        AddPenalty("coverage", 12, "第 " .. portal.number .. " 门后外场断治疗")
    end
end

local function RecordCurse(guid, name, spellID, now)
    local existing = state.curses[guid]
    if existing and now - existing.appliedAt < 1 then return end
    state.curses[guid] = {
        name = ShortName(name),
        appliedAt = now,
        spellID = spellID,
    }
    if spellID == SPELL.CURSE_DIRECT then
        state.metrics.curseApplications = state.metrics.curseApplications + 1
        AddPending(
            "curse", now, Profile().responseWindow, 1,
            "curse", 7,
            ShortName(name) .. " 中诅咒后未及时下达隔离/禁驱口令",
            "curseCalled"
        )
        RaidNotice("无尽痛苦诅咒 → " .. ShortName(name) .. "：隔离，禁止抢驱", 3)
    end
end

local function RecordCurseTransfer(sourceName, destGUID, destName, now)
    local key = ShortName(sourceName) .. ">" .. ShortName(destName)
    if state.lastTransfer[key] and now - state.lastTransfer[key] < 35 then return end
    state.lastTransfer[key] = now
    state.metrics.curseTransfers = state.metrics.curseTransfers + 1
    table.insert(state.curseEdges, {
        at = now - state.startedAt,
        source = ShortName(sourceName),
        target = ShortName(destName),
    })
    if #state.curseEdges > 30 then table.remove(state.curseEdges, 1) end
    RecordCurse(destGUID, destName, SPELL.CURSE_CHAIN, now)
    RaidNotice("诅咒转移 → " .. ShortName(destName) .. "：重新隔离", 3)
end

local function RecordDispel(extraSpellID, destName, now)
    if extraSpellID ~= SPELL.CURSE_DIRECT and extraSpellID ~= SPELL.CURSE_CHAIN then return end
    if CallWithin("dispel", now - 4, now + 0.2) then
        state.metrics.controlledDispels = state.metrics.controlledDispels + 1
    else
        state.metrics.uncontrolledDispels = state.metrics.uncontrolledDispels + 1
        AddPenalty("curse", 9, ShortName(destName) .. " 的诅咒未经团长授权被驱散")
        RaidNotice("检测到未授权驱散：诅咒会发生转移", 3)
    end
end

local function RecordStrike(now)
    if state.lastStrikeAt and now - state.lastStrikeAt < 4 then return end
    state.lastStrikeAt = now
    state.metrics.strikes = state.metrics.strikes + 1
    AddPending(
        "tank", now, 1.5, 6,
        "coverage", 6,
        "腐化打击前后没有内坦减伤/点刷口令",
        "strikeCalls"
    )
end

local function RecordDeath(guid, name, now)
    state.metrics.deaths = state.metrics.deaths + 1
    if state.firstDeath then return end
    state.firstDeath = ShortName(name)
    local damage = state.lastDamage[guid]
    if damage and now - damage.at <= 10 then
