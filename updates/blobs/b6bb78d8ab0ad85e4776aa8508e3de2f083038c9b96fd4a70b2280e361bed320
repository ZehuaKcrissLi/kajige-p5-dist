local function OverallScore()
    local total = 0
    local count = 0
    for _, value in pairs(state.score) do
        total = total + value
        count = count + 1
    end
    if count == 0 then return 0 end
    return math.floor((total / count) + 0.5)
end

local function AddPenalty(category, points, reason, uniqueKey)
    if not state.active then return end
    if uniqueKey then
        state.penaltyKeys = state.penaltyKeys or {}
        if state.penaltyKeys[uniqueKey] then return end
        state.penaltyKeys[uniqueKey] = true
    end
    state.score[category] = Clamp((state.score[category] or 100) - points, 0, 100)
    table.insert(state.penalties, {
        at = GetTime() - state.startedAt,
        category = category,
        points = points,
        reason = reason,
    })
    if #state.penalties > 20 then table.remove(state.penalties, 1) end
end

local function NormalizeRole(role)
    role = string.lower(role or "")
    if role == "tank" or role == "t" or role == "坦克" or role == "坦" then return "TANK" end
    if role == "healer" or role == "heal" or role == "h" or role == "治疗" or role == "奶" then return "HEALER" end
    if role == "damage" or role == "dps" or role == "d" or role == "输出" then return "DAMAGER" end
    return nil
end

local function ReadUnitRole(unit, rosterRole)
    local role
    if UnitGroupRolesAssigned then role = UnitGroupRolesAssigned(unit) end
    if role == "NONE" or role == "" then role = nil end
    if not role and rosterRole == "MAINTANK" then role = "TANK" end
    local name = UnitName(unit)
    if name and DB.manualRoles[ShortName(name)] then role = DB.manualRoles[ShortName(name)] end
    return role or "UNKNOWN"
end

local function RefreshRosterRoles()
    nameRoles = {}
    local raidCount = GetNumRaidMembers and GetNumRaidMembers() or 0
    if raidCount > 0 then
        for index = 1, raidCount do
            local name, _, _, _, _, _, _, online, _, rosterRole = GetRaidRosterInfo(index)
            if name and online ~= false then
                nameRoles[ShortName(name)] = ReadUnitRole("raid" .. index, rosterRole)
            end
        end
    else
        local playerName = UnitName("player")
        if playerName then nameRoles[ShortName(playerName)] = ReadUnitRole("player") end
        local partyCount = GetNumPartyMembers and GetNumPartyMembers() or 0
        for index = 1, partyCount do
            local unit = "party" .. index
            local name = UnitName(unit)
            if name then nameRoles[ShortName(name)] = ReadUnitRole(unit) end
        end
    end
    for name, role in pairs(DB.manualRoles) do nameRoles[ShortName(name)] = role end
end

local function RoleForName(name)
    return nameRoles[ShortName(name)] or DB.manualRoles[ShortName(name)] or "UNKNOWN"
end

local function RosterCounts()
    local counts = {TANK = 0, HEALER = 0, DAMAGER = 0, UNKNOWN = 0}
    for _, role in pairs(nameRoles) do counts[role] = (counts[role] or 0) + 1 end
    return counts
end

local function RealmCounts()
    local counts = {
        inside = 0,
        insideTanks = 0,
        insideHealers = 0,
        outsideTanks = 0,
        outsideHealers = 0,
        exhausted = 0,
        highBuffet = 0,
    }
    local now = GetTime()
    for name, role in pairs(nameRoles) do
        local inside = false
        for guid, info in pairs(state.realm) do
            if info.name == name and info.inside then inside = true break end
        end
        if inside then
            counts.inside = counts.inside + 1
            if role == "TANK" then counts.insideTanks = counts.insideTanks + 1 end
            if role == "HEALER" then counts.insideHealers = counts.insideHealers + 1 end
        else
            if role == "TANK" then counts.outsideTanks = counts.outsideTanks + 1 end
            if role == "HEALER" then counts.outsideHealers = counts.outsideHealers + 1 end
        end
    end
    for _, expiresAt in pairs(state.exhaustion) do
        if expiresAt > now then counts.exhausted = counts.exhausted + 1 end
    end
    for _, stacks in pairs(state.buffet) do
        if stacks >= Profile().buffetHigh then counts.highBuffet = counts.highBuffet + 1 end
    end
    return counts
end

