    tank = "tank", ["坦克"] = "tank", ["减伤"] = "tank",
    curse = "curse", ["诅咒"] = "curse", ["隔离"] = "curse",
    dispel = "dispel", ["驱散"] = "dispel",
    out = "outstop", outstop = "outstop", ["外停"] = "outstop",
    inside = "instop", instop = "instop", ["内停"] = "instop",
    push = "push", ["推进"] = "push", ["斩杀"] = "push",
}

SLASH_KAJIGESWCALL1 = "/swcall"
SlashCmdList.KAJIGESWCALL = function(message)
    local command = string.lower(string.match(message or "", "^%s*(%S+)") or "")
    local kind = slashAliases[command]
    if kind then
        RecordCall(kind)
        UpdateTexts()
    else
        Print("口令：/swcall ready|enter|tank|curse|dispel|out|inside|push")
    end
end

SLASH_KAJIGESWROLE1 = "/swrole"
SlashCmdList.KAJIGESWROLE = function(message)
    local name, roleText = string.match(message or "", "^%s*(%S+)%s+(%S+)%s*$")
    if not name or not roleText then
        Print("用法：/swrole 玩家名 坦克|治疗|输出；/swrole 玩家名 clear")
        return
    end
    if string.lower(roleText) == "clear" or roleText == "清除" then
        DB.manualRoles[ShortName(name)] = nil
        Print("已清除 " .. ShortName(name) .. " 的手动职责。")
    else
        local role = NormalizeRole(roleText)
        if not role then
            Print("无法识别职责；请使用坦克、治疗或输出。", true)
            return
        end
        DB.manualRoles[ShortName(name)] = role
        Print("已将 " .. ShortName(name) .. " 标记为 " .. roleText .. "。")
    end
    RefreshRosterRoles()
    UpdateTexts()
end

SLASH_KAJIGESWKALEC1 = "/swkalec"
SlashCmdList.KAJIGESWKALEC = function(message)
    local command = string.lower(string.match(message or "", "^%s*(%S+)") or "")
    if command == "reset" then
        state = NewState()
        Print("本轮状态和临时评分已重置。")
        UpdateTexts()
    elseif command == "report" then
        if DB.lastReport then Print(DB.lastReport.text) else Print("暂无复盘。", true) end
    elseif command == "audit" then
        AuditRoster(false)
    elseif command == "broadcast" then
        DB.broadcast = not DB.broadcast
        Print("口令广播已" .. (DB.broadcast and "开启" or "关闭") .. "。")
    elseif command == "hide" then
        frame:Hide()
    else
        if frame:IsShown() then frame:Hide() else frame:Show() UpdateTexts() end
    end
end

function KajigeKalecgosCoach_Show()
    frame:Show()
    UpdateTexts()
end

function KajigeKalecgosCoach_SetProfile(profile)
    if not profiles[profile] then return false end
    if state.active and DB.profile ~= profile then
        frame:Show()
        Print("战斗中已锁定评分模式；本轮结束后再切换。", true)
        return false
    end
    DB.profile = profile
    frame:Show()
    UpdateTexts()
    return true
end

function KajigeKalecgosCoach_KeyCall(kind)
    RecordCall(kind)
    UpdateTexts()
end

